---
// What the cloud box setup leaves you with, on /cloud-box-setup: three
// devices open the same sessions, and the sessions run on one always-on
// server. See docs/patterns/diagrams.md
import Diagram from "./Diagram.astro";
import { left, right } from "./paths";

const summary =
  "Diagram: one always-on server in your own account holds three jobs at once: one finished, one working and one waiting for your reply. The Claude app on your laptop, the Claude app on your phone and claude.ai in any browser all open the same three sessions. The server also holds your repos, vaults, skills, agents and connectors, and nothing runs on the laptop, the phone or the browser.";

const devices = [
  { name: "Laptop", opens: "Claude app" },
  { name: "Phone", opens: "Claude app" },
  { name: "Any browser", opens: "claude.ai" },
];

const sessions = [
  { title: "Plan today's tasks", state: "Finished", running: false },
  { title: "Fix signup flow", state: "Working", running: true },
  { title: "Plan Q1 roadmap", state: "Waiting for your reply", running: false },
];

const holds = ["Repos & vaults", "Skills & agents", "Connectors"];

// Stacked, the three 44px device cards sit 10px apart and 32px in from the
// figure's edge, and the rail runs down x 16 from the first card's centre to
// the server.
const comb = {
  lines: "M32 22.5H16.5V152M16.5 76.5H32M16.5 130.5H32",
  ends: [22.5, 76.5, 130.5].map(y => left(32, y)).join(""),
};

// The full column: the cards are 56px tall, centred at y 28, 94 and 160. A
// bar joins the outer two to the middle one's line, which runs on across.
const across = {
  lines: "M0 28.5H20.5V160.5H0M0 94.5H160",
  ends: [28.5, 94.5, 160.5].map(y => right(0, y)).join(""),
};
---

<Diagram summary={summary}>
  <div class="setup">
    <div class="devices">
      <p class="dg-level">Your devices</p>
      <p class="note">Nothing runs on these</p>
      <div class="set">
        <svg class="dg-wires comb" viewBox="0 0 32 152" aria-hidden="true">
          <path d={comb.lines}></path>
          <path class="end" d={comb.ends}></path>
        </svg>
        <ul>
          {
            devices.map(device => (
              <li class="dg-card">
                <b class="dg-name">{device.name}</b>{" "}
                <span class="opens">{device.opens}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="net">
      <svg class="dg-wires across" viewBox="0 0 160 188" aria-hidden="true">
        <path d={across.lines}></path>
        <path class="end" d={across.ends}></path>
      </svg>
      <p class="dg-tag">the same sessions</p>
    </div>

    <div class="dg-frame box">
      <div class="head">
        <p class="dg-level">Your server</p>
        <p class="dg-label">Always on</p>
      </div>
      <p class="dg-name">Every job you've started</p>
      <ul class="sessions">
        {
          sessions.map(session => (
            <li class="dg-card">
              <span class="title">{session.title}</span>{" "}
              <span class:list={["state", { running: session.running }]}>
                {session.state}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="dg-label on">Your whole setup</p>
      <ul class="holds">
        {holds.map(item => <li class="dg-chip">{item}</li>)}
      </ul>
    </div>
  </div>
  {
    Astro.slots.has("default") && (
      <Fragment slot="caption">
        <slot />
      </Fragment>
    )
  }
</Diagram>

<style>
  /* Stacked, the default: the devices in a column, a rail down their left
     and on to the server beneath. The device cards and the rail are a fixed
     size in px, so the SVG stays on the cards' numbers at a reader's larger
     text size. */
  .note {
    margin-top: 0.25rem;
    color: var(--dg-note);
  }

  .set {
    position: relative;
    margin-top: 0.625rem;
  }

  .set ul {
    display: grid;
    gap: 10px;
    margin-left: 32px;
  }

  .set li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 44px;
    padding-block: 0;
  }

  .opens {
    font-size: 0.8125rem;
    color: var(--dg-note);
    white-space: nowrap;
  }

  .comb {
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 152px;
  }

  .across {
    display: none;
  }

  /* The rail runs on from the SVG's x to the server, past the words on it */
  .net {
    position: relative;
    padding: 14px 0 14px 32px;
  }

  .net::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 16px;
    width: 1px;
    background: var(--dg-wire);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
  }

  .head > p {
    line-height: 1rem;
  }

  .box > .dg-name {
    margin-top: 0.375rem;
  }

  .sessions {
    display: grid;
    gap: var(--dg-gap);
    margin-top: 0.875rem;
  }

  .sessions li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    min-height: 3rem;
    padding: 0.625rem 0.75rem;
  }

  /* A session's title, as the Claude app shows it: the text face at a
     chip's size */
  .title {
    font-size: 0.8125rem;
  }

  .state {
    border-radius: 0.25rem;
    background: var(--dg-chip);
    padding: 0.1875rem 0.625rem;
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  /* The session that is working: the one filled part of the drawing */
  .state.running {
    background: var(--dg-fill);
    color: var(--dg-on-fill);
  }

  .on {
    margin-top: 0.875rem;
  }

  .holds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }

  /* The full column: devices on the left, the server on the right and one
     line between them, on a fixed grid of 160, 160 and 416px. The devices'
     label and note sit level with the server's label and heading, and the
     cards start 65px down, so the middle card's line meets the frame level
     with the middle session's centre. */
  @container diagram (width >= 46rem) {
    .setup {
      display: grid;
      grid-template-columns: 10rem 10rem 26rem;
      align-items: start;
    }

    .devices {
      padding-top: 0.8125rem;
    }

    .devices .dg-level {
      line-height: 1rem;
    }

    .note {
      margin-top: 0.375rem;
      line-height: 1.375rem;
      white-space: nowrap;
    }

    .set {
      margin-top: 0.5rem;
    }

    .set ul {
      gap: 0.625rem;
      margin-left: 0;
    }

    .set li {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0;
      height: 3.5rem;
    }

    .comb {
      display: none;
    }

    .net {
      margin-top: 4.0625rem;
      padding: 0;
    }

    .net::before {
      content: none;
    }

    .across {
      display: block;
      width: 10rem;
      height: 11.75rem;
    }

    /* Above the line, centred on its run from the bar to the server */
    .net .dg-tag {
      position: absolute;
      right: 0;
      bottom: 6.375rem;
      left: 1.25rem;
      max-width: none;
      margin-inline: auto;
      white-space: nowrap;
    }

    .box > .dg-name {
      line-height: 1.375rem;
    }

    .sessions {
      margin-top: 1.25rem;
    }

    .sessions li {
      flex-wrap: nowrap;
      height: 3rem;
      min-height: 0;
      padding-block: 0;
    }
  }

  /* Forced colours repaint every background as the page's ground, which
     would erase the line drawn as one */
  @media (forced-colors: active) {
    .net::before {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
