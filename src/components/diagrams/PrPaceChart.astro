---
// The setup page's chart of the PRs I merged each week, before and after I
// moved onto the server. Its figures are fixed, from one run of the tool the
// line under the chart credits, on its default rules (version 1.3.0), with
// weeks starting on a Monday in Europe/London. One switch moves
// the bars between weighted PRs and PRs. See "A chart" in
// docs/patterns/diagrams.md
import Diagram from "./Diagram.astro";

const summary =
  "Chart: the PRs I merged each week from 15th June to 22nd November 2026, each counted by its size as weighted PRs, with a marker at the beginning of September, when I moved my Claude Code setup onto the server. I averaged 16.9 weighted PRs a week in the 11 weeks before the marker and 77.9 in the 12 weeks from the week of 31st August (11.7 and 34.4 by plain PR count). The week of 7th September (my first full week on the server) was 64.5 weighted PRs, more than any week before it.";

// Week of, merged PRs, weighted PRs
const rows: [string, number, number][] = [
  ["2026-06-15", 25, 22.9],
  ["2026-06-22", 8, 8.1],
  ["2026-06-29", 11, 4.4],
  ["2026-07-06", 22, 32.2],
  ["2026-07-13", 11, 7.5],
  ["2026-07-20", 1, 0.2],
  ["2026-07-27", 12, 16.7],
  ["2026-08-03", 11, 9.8],
  ["2026-08-10", 11, 25.6],
  ["2026-08-17", 7, 21.5],
  ["2026-08-24", 10, 37.3],
  ["2026-08-31", 2, 4.8],
  ["2026-09-07", 30, 64.5],
  ["2026-09-14", 21, 38.2],
  ["2026-09-21", 22, 50.7],
  ["2026-09-28", 29, 110.6],
  ["2026-10-05", 18, 60.2],
  ["2026-10-12", 37, 109.2],
  ["2026-10-19", 48, 124.4],
  ["2026-10-26", 61, 109.1],
  ["2026-11-02", 53, 91.4],
  ["2026-11-09", 34, 70.9],
  ["2026-11-16", 58, 100.4],
];

// The first 11 weeks are before the move, the last 12 since
const BEFORE = 11;

const measures = {
  weighted: {
    label: "Weighted PRs",
    max: 132,
    ticks: [0, 50, 100],
    average: { before: 16.9, after: 77.9 },
    count: (value: number) => `${value.toFixed(1)} weighted PRs`,
  },
  prs: {
    label: "PRs",
    max: 64,
    ticks: [0, 20, 40, 60],
    average: { before: 11.7, after: 34.4 },
    count: (value: number) => `${value} ${value === 1 ? "PR" : "PRs"}`,
  },
};
type Measure = keyof typeof measures;
const ORDER: Measure[] = ["weighted", "prs"];

const MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(" ");
const monthOf = (iso: string) => MONTHS[Number(iso.slice(5, 7)) - 1];
const ordinal = (day: number) =>
  day >= 11 && day <= 13
    ? `${day}th`
    : `${day}${["th", "st", "nd", "rd"][day % 10] ?? "th"}`;

const weeks = rows.map(([iso, prs, weighted], i) => {
  const period = i < BEFORE ? "before" : "after";
  const value = { weighted, prs };
  return {
    after: period === "after",
    week: `${ordinal(Number(iso.slice(8)))} ${monthOf(iso)}`,
    count: {
      weighted: measures.weighted.count(weighted),
      prs: measures.prs.count(prs),
    },
    // A month's name sits under the first week that starts in it
    month:
      i === 0 || monthOf(iso) !== monthOf(rows[i - 1][0]) ? monthOf(iso) : "",
    // Each measure's value, and whether the bar rises past its period's
    // average, where the average line cuts it
    style: ORDER.map(
      key =>
        `--${key}:${value[key]};--cut-${key}:${value[key] > measures[key].average[period] ? 1 : 0}`
    ).join(";"),
  };
});

const chartStyle = [
  `--n:${rows.length}`,
  `--before:${BEFORE}`,
  ...ORDER.map(
    key =>
      `--${key}-max:${measures[key].max};--${key}-before:${measures[key].average.before};--${key}-after:${measures[key].average.after}`
  ),
].join(";");

const periods = [
  { heading: "On my laptop", key: "before" as const },
  { heading: "On the server", key: "after" as const },
];
---

<Diagram summary={summary}>
  <div class="chart" data-chart data-metric="weighted" style={chartStyle}>
    <div class="top">
      <p class="readout dg-mono" aria-hidden="true" data-readout>
        Pick a week to see its number
      </p>
      <div class="switch" role="group" aria-label="Count">
        {
          ORDER.map(key => (
            <button
              type="button"
              aria-pressed={key === "weighted" ? "true" : "false"}
              data-metric-to={key}
            >
              {measures[key].label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="periods">
      {
        periods.map(period => (
          <div class="period">
            <p class="dg-level">{period.heading}</p>
            {ORDER.map(key => (
              <p class:list={["average", key]}>
                <span class="dg-name dg-name-lg">
                  {measures[key].average[period.key]}
                </span>{" "}
                {key === "weighted" ? "weighted PRs" : "PRs"} a week
              </p>
            ))}
          </div>
        ))
      }
    </div>

    <div class="plot">
      {
        ORDER.map(key => (
          <div class:list={["rules", key]} aria-hidden="true">
            {measures[key].ticks.map(tick => (
              <span class="rule" style={`--at:${tick / measures[key].max}`}>
                <span class="value">{tick}</span>
              </span>
            ))}
          </div>
        ))
      }
      <div class="bars" role="group" aria-label="Weeks">
        {
          weeks.map((week, i) => (
            <button
              type="button"
              class:list={["week", { after: week.after }]}
              tabindex={i === 0 ? 0 : -1}
              aria-label={`Week of ${week.week}: ${week.count.weighted}, ${week.count.prs}`}
              data-week={week.week}
              data-weighted={week.count.weighted}
              data-prs={week.count.prs}
              style={week.style}
            >
              <span class="bar" />
            </button>
          ))
        }
      </div>
      <span class="marker" aria-hidden="true"></span>
      <span class="moved" aria-hidden="true"
        ><span>Moved to the server</span></span
      >
    </div>

    <ol class="months dg-label" aria-hidden="true">
      {weeks.map(week => <li>{week.month}</li>)}
    </ol>

    <!-- A table keeps the width of its contents whatever width it is given,
    so the box that hides it is a div -->
    <div class="sr-only">
      <table>
        <caption>Merged PRs and weighted PRs by week</caption>
        <thead>
          <tr>
            <th scope="col">Week of</th>
            <th scope="col">Weighted PRs</th>
            <th scope="col">PRs</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(([, prs, weighted], i) => (
              <tr>
                <th scope="row">{weeks[i].week}</th>
                <td>{weighted.toFixed(1)}</td>
                <td>{prs}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Diagram>

<style>
  /* The plot's heights are px, so a reader's larger text grows the words and
     not the drawing. The gutter for the grid values is rem, so a value still
     fits it at a larger text size, and the bars share out what is left. */
  .chart {
    --gutter: 1.75rem;
    --plot: 216px;
    --inset: 1px;
  }

  /* Which measure shows is one attribute. Every height reads its value over
     the scale's top, so setting it redraws the chart. */
  .chart[data-metric="weighted"] {
    --max: var(--weighted-max);
    --avg-before: var(--weighted-before);
    --avg-after: var(--weighted-after);
  }

  .chart[data-metric="prs"] {
    --max: var(--prs-max);
    --avg-before: var(--prs-before);
    --avg-after: var(--prs-after);
  }

  .chart[data-metric="weighted"] .prs,
  .chart[data-metric="prs"] .weighted {
    display: none;
  }

  .chart[data-metric="weighted"] .week {
    --v: var(--weighted);
    --cut: var(--cut-weighted);
  }

  .chart[data-metric="prs"] .week {
    --v: var(--prs);
    --cut: var(--cut-prs);
  }

  /* The readout and the switch. The row keeps its space until the script
     runs, so nothing moves when it appears and a control that can't work
     never shows. */
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .chart:not([data-initialized]) .top {
    visibility: hidden;
  }

  /* As wide as the longest week's text, so the switch wraps by the figure's
     width and never by what the readout says */
  .readout {
    flex: 1 1 auto;
    min-width: min(100%, 39ch);
    color: var(--dg-note);
  }

  .switch {
    display: flex;
    gap: 0.25rem;
  }

  /* The unchosen button has no border, not a transparent one, which forced
     colours would paint. Its padding stands in for the border's pixel. */
  .switch button {
    border-radius: 9999px;
    padding: calc(0.1875rem + 1px) calc(0.625rem + 1px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dg-note);
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  @media (hover: hover) {
    .switch button[aria-pressed="false"]:hover {
      color: var(--accent);
    }
  }

  .switch button[aria-pressed="false"]:active {
    color: var(--accent-strong);
  }

  .switch button[aria-pressed="true"] {
    border: 1px solid var(--dg-wire);
    padding: 0.1875rem 0.625rem;
    color: var(--foreground);
  }

  /* Each period's heading sits over its own weeks */
  .periods {
    display: grid;
    grid-template-columns: calc(var(--before) / var(--n) * 100%) minmax(0, 1fr);
    margin: 1.25rem 0 0 var(--gutter);
  }

  .period + .period {
    padding-left: 0.75rem;
  }

  .period .dg-level {
    white-space: normal;
  }

  .average {
    margin-top: 0.125rem;
    color: var(--dg-note);
  }

  .plot {
    position: relative;
    height: var(--plot);
    margin: 0.875rem 0 0 var(--gutter);
  }

  .rule {
    position: absolute;
    right: 0;
    bottom: calc(var(--at) * 100%);
    left: 0;
    border-top: 1px solid var(--dg-border);
  }

  .rule:first-child {
    border-top-color: var(--dg-wire);
  }

  .value {
    position: absolute;
    top: -0.5rem;
    right: calc(100% + 0.375rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--dg-note);
  }

  .bars {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
  }

  /* Each week's button fills its column to the plot's full height, with the
     bar drawn at its foot, so a bar 1px tall can still be tapped */
  .week {
    --avg: var(--avg-before);

    position: relative;
  }

  .week.after {
    --avg: var(--avg-after);
  }

  .week:focus-visible {
    z-index: 1;
  }

  .bar {
    position: absolute;
    right: var(--inset);
    bottom: 0;
    left: var(--inset);
    height: max(1px, var(--v) / var(--max) * 100%);
    border-radius: 2px 2px 0 0;
    background: var(--dg-wire);
    transition: background-color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .week.after .bar {
    background: var(--foreground);
  }

  @media (hover: hover) {
    .week:hover .bar {
      background: var(--accent);
    }
  }

  .week[data-chosen] .bar {
    background: var(--accent);
  }

  .week:active .bar {
    background: var(--accent-strong);
  }

  /* The period's average: a line behind the bars, and a cut in the ground
     colour through each bar that rises past it. Both sit on the button's
     box, which is the plot's height, so the two land on the same pixel. */
  .week::before,
  .week::after {
    content: "";
    position: absolute;
    bottom: calc(var(--avg) / var(--max) * 100%);
    border-top: 1px solid;
  }

  .week::before {
    right: 0;
    left: 0;
    border-top-color: var(--dg-wire);
  }

  .week::after {
    right: var(--inset);
    left: var(--inset);
    border-top-color: var(--background);
    opacity: var(--cut);
  }

  .marker {
    position: absolute;
    top: -8px;
    bottom: 0;
    left: calc(var(--before) / var(--n) * 100%);
    border-left: 1px dashed var(--dg-wire);
    pointer-events: none;
  }

  /* The marker's label wraps inside the room to the marker's left */
  .moved {
    position: absolute;
    top: -8px;
    left: 0;
    width: calc(var(--before) / var(--n) * 100% - 0.5rem);
    font-size: 0.8125rem;
    line-height: 1.2;
    text-align: right;
    color: var(--dg-note);
    pointer-events: none;
  }

  /* Wrapped on a phone, it can reach down to a grid line, which breaks
     round its words */
  .moved span {
    background: var(--background);
  }

  .months {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0.375rem 0 0 var(--gutter);
  }

  .months li {
    padding-left: var(--inset);
    white-space: nowrap;
  }

  /* Narrower than the readout's longest text, which wraps there, the
     readout keeps two lines so a week's text doesn't move the plot */
  @container diagram (width < 21rem) {
    .readout {
      min-height: 2lh;
    }
  }

  @container diagram (width >= 46rem) {
    .chart {
      --plot: 256px;
      --inset: 2px;
    }
  }

  /* Forced colours repaint every background as the page's ground, so the
     bars and lines paint themselves. The selectors match the specificity of
     the rules they override. */
  @media (forced-colors: active) {
    .week .bar,
    .week::before,
    .week::after,
    .rule:first-child,
    .marker {
      forced-color-adjust: none;
    }

    .week .bar,
    .week.after .bar {
      background: CanvasText;
    }

    .week::before,
    .rule:first-child {
      border-top-color: CanvasText;
    }

    .week::after {
      border-top-color: Canvas;
    }

    .marker {
      border-left-color: CanvasText;
    }

    .week[data-chosen] .bar,
    .week:active .bar {
      background: Highlight;
    }
  }

  @media (forced-colors: active) and (hover: hover) {
    .week:hover .bar {
      background: Highlight;
    }
  }
</style>

<script>
  function initPrPaceChart() {
    const chart = document.querySelector<HTMLElement>("[data-chart]");
    if (!chart || chart.dataset.initialized) return;
    chart.dataset.initialized = "true";

    const readout = chart.querySelector<HTMLElement>("[data-readout]")!;
    const rest = readout.textContent!.trim();
    const switches = [
      ...chart.querySelectorAll<HTMLButtonElement>("[data-metric-to]"),
    ];
    const weeks = [...chart.querySelectorAll<HTMLButtonElement>("[data-week]")];
    let pointed: HTMLButtonElement | undefined;
    let chosen: HTMLButtonElement | undefined;

    // The week under the pointer, or else the chosen week
    const show = () => {
      const week = pointed ?? chosen;
      readout.textContent = week
        ? `Week of ${week.dataset.week} · ${week.dataset[chart.dataset.metric!]}`
        : rest;
    };

    // The tab stop moves to the chosen week
    const choose = (week: HTMLButtonElement) => {
      if (week === chosen) return;
      chosen?.removeAttribute("data-chosen");
      week.setAttribute("data-chosen", "");
      weeks.forEach(other => (other.tabIndex = other === week ? 0 : -1));
      chosen = week;
      show();
    };

    switches.forEach(button =>
      button.addEventListener("click", () => {
        chart.dataset.metric = button.dataset.metricTo;
        switches.forEach(other =>
          other.setAttribute("aria-pressed", String(other === button))
        );
        show();
      })
    );

    const last = weeks.length - 1;
    weeks.forEach((week, i) => {
      week.addEventListener("pointerenter", () => {
        pointed = week;
        show();
      });
      week.addEventListener("pointerleave", () => {
        pointed = undefined;
        show();
      });
      // Safari doesn't focus a button on a click, so the click chooses too
      week.addEventListener("click", () => choose(week));
      week.addEventListener("focus", () => choose(week));
      week.addEventListener("keydown", event => {
        const to = (
          { ArrowLeft: i - 1, ArrowRight: i + 1, Home: 0, End: last } as Record<
            string,
            number
          >
        )[event.key];
        if (to === undefined) return;
        event.preventDefault();
        weeks[Math.min(Math.max(to, 0), last)].focus();
      });
    });
  }

  // See "Client scripts and View Transitions" in docs/patterns/client-scripts.md
  document.addEventListener("astro:page-load", initPrPaceChart);
  initPrPaceChart();
</script>
