---
type Props = {
  tag: string;
  tagName: string;
  // "row" is a line of the tags page, with the tag's post count at its end
  variant?: "inline" | "row";
  count?: number;
};

const { tag, tagName, variant = "inline", count } = Astro.props;
---

{
  variant === "row" ? (
    <li class="border-b border-border">
      <a
        href={`/tags/${tag}`}
        class="group flex items-baseline justify-between gap-4 py-3 interactive"
      >
        <span transition:name={tag}>
          <span class="underline decoration-dashed underline-offset-4 group-focus-visible:no-underline">
            {tagName}
          </span>
        </span>
        <span class="meta transition-colors group-hover:text-accent group-active:text-accent-strong">
          {count}
          <span class="sr-only">{count === 1 ? " post" : " posts"}</span>
        </span>
      </a>
    </li>
  ) : (
    <li>
      <a
        href={`/tags/${tag}`}
        transition:name={tag}
        class="group inline-block py-1 interactive"
      >
        <span class="underline decoration-dashed underline-offset-4 group-focus-visible:no-underline">
          {tagName}
        </span>
      </a>
    </li>
  )
}
