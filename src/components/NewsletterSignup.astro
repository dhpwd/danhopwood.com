<div
  class="newsletter-signup not-prose mt-8 mb-8 rounded-lg border border-border p-6"
>
  <h2 class="title-item">Build Notes</h2>
  <p class="mt-1 text-sm text-foreground/80">
    Every Thursday morning. Discoveries from building Fidero entirely with AI
    agents – the patterns, tools and decisions that actually worked.
  </p>
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/dhpwd"
    method="post"
    class="mt-3 flex gap-2"
  >
    <input type="hidden" name="tag" value="website" />
    <input type="hidden" name="embed" value="1" />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <input type="text" name="bd_hp" tabindex="-1" autocomplete="off" />
    </div>
    <input
      type="email"
      name="email"
      aria-label="Email address"
      placeholder="you@example.com"
      required
      class="min-w-0 flex-1 rounded border border-foreground/60 bg-background px-3 py-2 text-base text-foreground transition-[border-color,box-shadow] placeholder:text-foreground/75 focus:border-foreground focus:ring-1 focus:ring-foreground focus:outline-hidden sm:pointer-fine:text-sm"
    />
    <button
      type="submit"
      class="interactive-fill rounded bg-accent px-4 py-2 text-base font-medium text-background disabled:opacity-60 sm:pointer-fine:text-sm"
    >
      Subscribe
    </button>
  </form>
  <p class="mt-2 text-sm text-foreground/80" role="status" data-newsletter-msg>
  </p>
  <p class="mt-2 text-sm text-foreground/80">
    <a
      href="https://buttondown.com/dhpwd/archive"
      target="_blank"
      rel="noopener"
      class="interactive underline decoration-dashed underline-offset-4"
      >Read the latest issue</a
    >
  </p>
</div>

<script>
  function initNewsletterForms() {
    document
      .querySelectorAll<HTMLFormElement>(".newsletter-signup form")
      .forEach(form => {
        if (form.dataset.initialized) return;
        form.dataset.initialized = "true";

        const button = form.querySelector<HTMLButtonElement>(
          "button[type=submit]"
        )!;
        const status = form.parentElement!.querySelector(
          "[data-newsletter-msg]"
        )!;

        // Subscribes through our own function, api/subscribe.ts, and falls
        // back to the form's native same-tab POST to Buttondown on anything
        // else – see docs/external-services.md. form.submit() skips the submit
        // event, so the fallback can't loop.
        form.addEventListener("submit", async event => {
          event.preventDefault();
          if (typeof window.plausible === "function") {
            window.plausible("Newsletter Signup");
          }
          status.textContent = "";
          // Disabling a focused button drops focus to <body>, so note where
          // it was and put it back once the button is enabled again
          const focused = document.activeElement;
          button.disabled = true;

          let ok = false;
          try {
            const response = await fetch("/api/subscribe", {
              method: "POST",
              body: new FormData(form),
              signal: AbortSignal.timeout(8000),
            });
            ok = response.ok;
          } catch {
            // Also catches browsers without AbortSignal.timeout, which throws
            // before fetch runs
          }

          button.disabled = false;
          if (ok) {
            form.reset();
            status.textContent =
              "Almost there – check your inbox to confirm your subscription.";
            if (focused instanceof HTMLElement) focused.focus();
          } else {
            form.submit();
          }
        });
      });
  }

  // The client router swaps the DOM without re-running this module, so the
  // listeners have to be re-attached per navigation.
  document.addEventListener("astro:page-load", initNewsletterForms);
</script>
