<div
  class="newsletter-signup not-prose mt-8 mb-8 rounded-lg border border-border p-6 dark:border-accent"
>
  <h2 class="text-xl font-semibold">Build Notes</h2>
  <p class="mt-1 text-sm opacity-80">
    Every Thursday morning. Discoveries from building Fidero entirely with AI
    agents – the patterns, tools and decisions that actually worked.
  </p>
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/dhpwd"
    method="post"
    class="mt-3 flex gap-2"
  >
    <input type="hidden" name="tag" value="website" />
    <input type="hidden" name="embed" value="1" />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <input type="text" name="bd_hp" tabindex="-1" autocomplete="off" />
    </div>
    <input
      type="email"
      name="email"
      aria-label="Email address"
      placeholder="you@example.com"
      required
      class="flex-1 rounded border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:opacity-50 focus:border-accent focus:outline-none"
    />
    <button
      type="submit"
      class="rounded bg-accent px-4 py-2 text-sm font-medium text-white hover:opacity-90 disabled:opacity-60"
    >
      Subscribe
    </button>
  </form>
  <p class="mt-2 text-sm opacity-80" role="status" data-newsletter-msg></p>
  <p class="mt-2 text-sm opacity-80">
    <a
      href="https://buttondown.com/dhpwd/archive"
      target="_blank"
      rel="noopener"
      class="underline decoration-dashed underline-offset-4 hover:text-accent"
      >Read the latest issue</a
    >
  </p>
</div>

<script>
  function initNewsletterForms() {
    document
      .querySelectorAll<HTMLFormElement>(".newsletter-signup form")
      .forEach(form => {
        if (form.dataset.initialized) return;
        form.dataset.initialized = "true";

        const button = form.querySelector<HTMLButtonElement>(
          "button[type=submit]"
        )!;
        const status = form.parentElement!.querySelector(
          "[data-newsletter-msg]"
        )!;

        // The fetch goes to our own function, api/subscribe.ts. Anything short
        // of a confirmed signup falls back to the form's native POST to
        // Buttondown, in the same tab, where Buttondown handles CAPTCHA,
        // duplicates and validation – see docs/external-services.md.
        // form.submit() skips the submit event, so the fallback can't loop.
        form.addEventListener("submit", async event => {
          event.preventDefault();
          if (typeof window.plausible === "function") {
            window.plausible("Newsletter Signup");
          }
          button.disabled = true;

          let ok = false;
          try {
            const response = await fetch("/api/subscribe", {
              method: "POST",
              body: new FormData(form),
              signal: AbortSignal.timeout(8000),
            });
            ok = response.ok;
          } catch {
            // A network error or timeout takes the fallback below
          }

          if (ok) {
            form.hidden = true;
            status.textContent =
              "Almost there – check your inbox to confirm your subscription.";
          } else {
            button.disabled = false;
            form.submit();
          }
        });
      });
  }

  // The client router swaps the DOM without re-running this module, so the
  // listeners have to be re-attached per navigation.
  document.addEventListener("astro:page-load", initNewsletterForms);
</script>
