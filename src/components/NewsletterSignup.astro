---
import type { ComponentProps } from "astro/types";
import Button from "./Button.astro";
import LedgerRow from "./LedgerRow.astro";

// "row" drops the box and sets the name as the row's label, for the
// homepage's first screen. The form and its script are the same in both.
type Props = { variant?: "box" | "row" };

const { variant = "box" } = Astro.props;
const row = variant === "row";
const name = "Build Notes";

// The row opens the homepage's list, so its rule stays still. The script
// finds the form by the newsletter-signup class. TypeScript checks a dynamic
// tag's props against both tags at once, so the cast types them as the row's,
// and `satisfies` keeps the row's own props checked.
const Wrapper = row ? LedgerRow : "div";
const rowProps = (
  row
    ? ({ label: name, draw: false } satisfies ComponentProps<typeof LedgerRow>)
    : {}
) as ComponentProps<typeof LedgerRow>;
---

<Wrapper
  {...rowProps}
  class:list={[
    "newsletter-signup not-prose",
    row ? "pt-6" : "mt-8 mb-8 rounded-lg border border-border p-6",
  ]}
>
  {!row && <h2 class="title-item">{name}</h2>}
  <div class={row ? "min-w-0" : "contents"}>
    <p
      class={row
        ? "text-small leading-normal"
        : "mt-1 text-sm text-foreground/80"}
    >
      Every Thursday morning. Discoveries from building Fidero entirely with AI
      agents – the patterns, tools and decisions that actually worked.
    </p>
    <form
      action="https://buttondown.com/api/emails/embed-subscribe/dhpwd"
      method="post"
      class="mt-3 flex gap-2"
    >
      <input type="hidden" name="tag" value="website" />
      <input type="hidden" name="embed" value="1" />
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <input type="text" name="bd_hp" tabindex="-1" autocomplete="off" />
      </div>
      <input
        type="email"
        name="email"
        aria-label="Email address"
        placeholder="you@example.com"
        required
        class="min-w-0 flex-1 field"
      />
      <Button type="submit" inline>Subscribe</Button>
    </form>
    <p
      class="mt-2 text-sm text-foreground/80"
      role="status"
      data-newsletter-msg
    >
    </p>
    <p class="mt-2 text-sm text-foreground/80">
      <a
        href="https://buttondown.com/dhpwd/archive"
        target="_blank"
        rel="noopener"
        class="interactive link-underline">Read the latest issue</a
      >
    </p>
  </div>
</Wrapper>

<script>
  function initNewsletterForms() {
    document
      .querySelectorAll<HTMLFormElement>(".newsletter-signup form")
      .forEach(form => {
        if (form.dataset.initialized) return;
        form.dataset.initialized = "true";

        const button = form.querySelector<HTMLButtonElement>(
          "button[type=submit]"
        )!;
        const status = form.parentElement!.querySelector(
          "[data-newsletter-msg]"
        )!;

        // Subscribes through our own function, api/subscribe.ts, and falls
        // back to the form's native same-tab POST to Buttondown on anything
        // else – see docs/external-services.md. form.submit() skips the submit
        // event, so the fallback can't loop.
        form.addEventListener("submit", async event => {
          event.preventDefault();
          if (typeof window.plausible === "function") {
            window.plausible("Newsletter Signup");
          }
          status.textContent = "";
          // Disabling a focused button drops focus to <body>, so note where
          // it was and put it back once the button is enabled again
          const focused = document.activeElement;
          button.disabled = true;

          let ok = false;
          try {
            const response = await fetch("/api/subscribe", {
              method: "POST",
              body: new FormData(form),
              signal: AbortSignal.timeout(8000),
            });
            ok = response.ok;
          } catch {
            // Also catches browsers without AbortSignal.timeout, which throws
            // before fetch runs
          }

          button.disabled = false;
          if (ok) {
            form.reset();
            status.textContent =
              "Almost there – check your inbox to confirm your subscription.";
            if (focused instanceof HTMLElement) focused.focus();
          } else {
            form.submit();
          }
        });
      });
  }

  // See "Client scripts and View Transitions" in docs/patterns/client-scripts.md
  document.addEventListener("astro:page-load", initNewsletterForms);
  initNewsletterForms();
</script>
