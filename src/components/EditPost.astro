---
import type { CollectionEntry } from "astro:content";
import { SITE } from "@/config";
import LedgerRow from "./LedgerRow.astro";

type Props = {
  hideEditPost?: CollectionEntry<"blog">["data"]["hideEditPost"];
  post: CollectionEntry<"blog">;
};

const { hideEditPost, post } = Astro.props;

const href = `${SITE.editPost.url}${post.filePath}`;
const showEditPost =
  SITE.editPost.enabled && !hideEditPost && href.trim() !== "";
---

{
  showEditPost && (
    <LedgerRow label="Source" class="py-5">
      <p>
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block py-1 interactive"
        >
          <span class="link-underline">{SITE.editPost.text}</span>
        </a>
      </p>
    </LedgerRow>
  )
}
