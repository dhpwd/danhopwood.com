---
import type { CollectionEntry } from "astro:content";
import { SITE } from "@/config";

type Props = {
  hideEditPost?: CollectionEntry<"blog">["data"]["hideEditPost"];
  post: CollectionEntry<"blog">;
};

const { hideEditPost, post } = Astro.props;

const href = `${SITE.editPost.url}${post.filePath}`;
const showEditPost =
  SITE.editPost.enabled && !hideEditPost && href.trim() !== "";
---

{
  showEditPost && (
    <div class="ledger border-t border-border py-5">
      <h2 class="label-caps text-foreground/75">Source</h2>
      <p>
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block py-1 interactive underline decoration-dashed underline-offset-4"
        >
          {SITE.editPost.text}
        </a>
      </p>
    </div>
  )
}
