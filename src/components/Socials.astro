---
import { SOCIALS } from "@/constants";
import IconRss from "@/assets/icons/IconRss.svg";

// The footer's row of profile links, with the feed last.
const links = [
  ...SOCIALS,
  { name: "RSS", icon: IconRss, href: "/rss.xml", linkTitle: "RSS Feed" },
];
---

<ul class="icon-links items-center">
  {
    links.map(({ name, icon: Icon, href, linkTitle }) => (
      <li>
        <a {href} title={linkTitle} class="icon-link">
          <Icon class="icon-tilt size-5" aria-hidden="true" />
          <span class="sr-only">{name}</span>
        </a>
      </li>
    ))
  }
</ul>
