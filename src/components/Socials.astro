---
import { SOCIALS } from "@/constants";

// The footer's row of profile links, with the feed last.
const links = [
  ...SOCIALS.map(({ name, href, linkTitle }) => ({
    label: name,
    href,
    title: linkTitle,
  })),
  { label: "RSS", href: "/rss.xml", title: "RSS Feed" },
];
---

<ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
  {
    links.map(({ label, href, title }) => (
      <li>
        <a
          {href}
          {title}
          class="inline-block py-2 interactive underline decoration-dashed underline-offset-4 sm:py-1"
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>
