---
// The title block of an offer page: the mono accent line, the title and an
// opening paragraph, which is the default slot.
type Props = {
  eyebrow: string;
  title: string;
};

const { eyebrow, title } = Astro.props;
---

<div class="flex flex-col gap-5">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="title-page">{title}</h1>
  <p class="max-w-measure text-[1.1875rem] leading-[1.55]"><slot /></p>
</div>
