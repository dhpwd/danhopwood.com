---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { SITE } from "@/config";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
  stealThisPost?: boolean;
} & HTMLAttributes<"footer">;

const {
  noMarginTop = false,
  stealThisPost = false,
  class: className,
  ...attrs
} = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-5 text-[0.9375rem]",
      "border-t border-border",
      "flex flex-col gap-x-8 gap-y-1 sm:flex-row sm:items-center sm:justify-between",
    ]}
  >
    {
      stealThisPost ? (
        <a
          href="https://github.com/dhpwd/danhopwood.com"
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 interactive text-foreground/75 sm:py-1"
        >
          Steal this post → CC BY 4.0 · Code MIT
        </a>
      ) : (
        <span class="py-2 text-foreground/75 sm:py-1">
          &#169; {currentYear}
          {SITE.author}
        </span>
      )
    }
    <Socials />
  </div>
</footer>
