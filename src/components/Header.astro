---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";

const section = Astro.url.pathname.split("/")[1];

// Tags and archives are ways into the posts, so they sit under Posts.
const NAV = [
  { href: "/posts", label: "Posts", sections: ["posts", "tags", "archives"] },
  { href: "/about", label: "About", sections: ["about"] },
  { href: "/search", label: "Search", sections: ["search"] },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg focus:top-4"
>
  Skip to content
</a>

<header class="app-layout">
  <div
    id="top-nav-wrap"
    class="flex flex-wrap items-center gap-x-1 border-b border-border py-3 sm:gap-x-3 sm:py-6"
  >
    <a
      href="/"
      class="me-auto py-1 font-mono text-xl leading-8 font-semibold tracking-tight whitespace-nowrap interactive sm:text-2xl sm:leading-none"
    >
      {SITE.title}
    </a>
    <!-- Ahead of the links in the markup, so Tab from an opened menu reaches
    them. order-1 still draws it after the theme toggle. -->
    <button
      id="menu-btn"
      class="order-1 -me-2 px-2 py-3 label-caps interactive sm:hidden"
      aria-expanded="false"
      aria-controls="menu-items"
    >
      Menu
    </button>
    <nav
      id="nav-menu"
      aria-label="Main"
      class="order-last basis-full sm:order-none sm:basis-auto"
    >
      <ul
        id="menu-items"
        class="mt-3 hidden flex-col border-t border-border pt-1 sm:mt-0 sm:flex sm:flex-row sm:gap-x-6 sm:border-0 sm:pt-0"
      >
        {
          NAV.map(({ href, label, sections }) => (
            <li>
              <a
                {href}
                class:list={[
                  "block py-3 font-medium interactive sm:px-1 sm:py-1",
                  { "active-nav": sections.includes(section) },
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      SITE.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="relative size-11 interactive sm:size-8"
          title="Toggles light & dark"
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-[scale,rotate] motion-reduce:transition-none dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-[scale,rotate] motion-reduce:transition-none dark:scale-100 dark:rotate-0" />
        </button>
      )
    }
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");

    if (!menuBtn || !menuItems) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.textContent = openMenu ? "Menu" : "Close";

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("flex");
    });
  }

  toggleNav();

  document.addEventListener("astro:after-swap", toggleNav);
</script>
