---
// An offer page's questions, each answer opening on a tap through the
// browser's own disclosure – see "An offer page's questions open on a tap" in
// docs/design-decisions.md. The answers stay in the HTML, so the page's
// Markdown twin writes each question as a heading over its answer.
type Props = {
  items: { question: string; answer: string }[];
};

const { items } = Astro.props;
---

<div>
  {
    items.map(({ question, answer }) => (
      <details class="group border-b border-border first:border-t">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-3 interactive [&::-webkit-details-marker]:hidden">
          <h3>{question}</h3>
          <span aria-hidden="true" class="font-mono">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">−</span>
          </span>
        </summary>
        <p class="max-w-measure pb-4">{answer}</p>
      </details>
    ))
  }
</div>
