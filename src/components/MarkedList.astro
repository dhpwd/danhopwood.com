---
// A list with accent markers: bullets, or mono numerals when `ordered`.
type Props = {
  ordered?: boolean;
};

const { ordered = false } = Astro.props;

const List = ordered ? "ol" : "ul";
---

<List
  class:list={[
    "flex flex-col gap-2.5 list-indent marker:text-accent",
    ordered
      ? // 15px at the 17px body size, in em so the step scales with the
        // list's indent – see docs/patterns/lists.md
        "list-decimal marker:font-mono marker:text-[length:calc(15em/17)]"
      : "list-disc",
  ]}
>
  <slot />
</List>
