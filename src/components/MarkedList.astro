---
// A list with accent markers: bullets, or mono numerals when `ordered`.
type Props = {
  ordered?: boolean;
};

const { ordered = false } = Astro.props;

const List = ordered ? "ol" : "ul";
---

<List
  class:list={[
    "flex flex-col gap-2.5 list-edge marker:text-accent",
    ordered
      ? // The marker's width is three mono characters ("1. ") at its 15px
        "list-decimal [--list-marker:1.6875rem] marker:font-mono marker:text-[0.9375rem]"
      : "list-disc",
  ]}
>
  <slot />
</List>
