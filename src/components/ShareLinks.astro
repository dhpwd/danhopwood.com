---
import { SHARE_LINKS } from "@/constants";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageUrl = Astro.url.href;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="ledger border-t border-border py-5">
      <h2 class="label-caps text-foreground/75">Share</h2>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {SHARE_LINKS.map(social => (
          <li>
            <a
              href={social.buildHref(pageUrl, title)}
              class="inline-block py-1 interactive underline decoration-dashed underline-offset-4"
              title={social.linkTitle}
              target="_blank"
              rel="noopener noreferrer"
              data-share={social.name}
            >
              {social.label ?? social.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-share]").forEach(link => {
    link.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("Share Link", {
          props: { platform: link.dataset.share },
        });
      }
    });
  });
</script>
