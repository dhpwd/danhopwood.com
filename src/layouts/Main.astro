---
import { SITE } from "@/config";

type Props = {
  pageTitle: string;
  // The view-transition name the title shares with the link that led here
  titleTransition?: string;
  // The mono accent line above the title
  eyebrow?: string;
};

const { pageTitle, titleTransition, eyebrow } = Astro.props;

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

<main data-backUrl={backUrl} id="main-content" class="app-layout pb-4">
  <div class="flex flex-col gap-3 pt-9 pb-8 sm:pt-14 sm:pb-10">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="title-page">
      {
        titleTransition ? (
          <span transition:name={titleTransition}>{pageTitle}</span>
        ) : (
          pageTitle
        )
      }
    </h1>
    <slot name="intro" />
  </div>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
