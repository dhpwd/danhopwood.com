---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import BackButton from "@/components/BackButton.astro";
import ImageZoom from "@/components/ImageZoom.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { calculateReadingTime } from "@/utils/readingTime";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content } = await render(post);
const readingTime = post.body ? calculateReadingTime(post.body) : undefined;

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Left undefined when nothing resolves, so Layout applies the site default.
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main id="main-content" class="app-layout pb-12">
    <div
      class:list={[
        "flex flex-col gap-3",
        { "pt-9 sm:pt-14": !SITE.showBackButton },
      ]}
    >
      <Datetime
        {pubDatetime}
        {modDatetime}
        {timezone}
        {readingTime}
        tone="eyebrow"
      />
      <h1
        data-pagefind-body
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="title-page text-foreground"
      >
        {title}
      </h1>
    </div>
    <article
      data-pagefind-body
      id="article"
      class="app-prose mt-8 w-full max-w-app sm:mt-10 prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <NewsletterSignup />

    <div data-rule class="ledger border-t border-border py-5">
      <h2 class="label-caps text-foreground/75">Tags</h2>
      <ul data-pagefind-body class="flex flex-wrap gap-x-5 gap-y-1">
        {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
      </ul>
    </div>

    <ShareLinks title={title} />

    <EditPost {hideEditPost} {post} />

    <nav
      aria-label="More posts"
      class="grid grid-cols-1 gap-6 border-t border-border pt-6 sm:grid-cols-2 sm:gap-8"
    >
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="group flex flex-col gap-1 interactive"
          >
            <span class="label-caps text-foreground/75 transition-colors group-hover:text-accent group-active:text-accent-strong">
              Previous post
            </span>
            <span class="font-medium">
              <span class="decoration-dashed underline-offset-4 group-focus-visible:no-underline motion-reduce:group-hover:underline">
                {prevPost.title}
              </span>
            </span>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="group flex flex-col gap-1 interactive sm:col-start-2 sm:items-end sm:text-end"
          >
            <span class="label-caps text-foreground/75 transition-colors group-hover:text-accent group-active:text-accent-strong">
              Next post
            </span>
            <span class="font-medium">
              <span class="decoration-dashed underline-offset-4 group-focus-visible:no-underline motion-reduce:group-hover:underline">
                {nextPost.title}
              </span>
            </span>
          </a>
        )
      }
    </nav>
  </main>
  <ImageZoom />
  <Footer stealThisPost />
</Layout>

<script is:inline data-astro-rerun>
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("#article :is(h2, h3, h4, h5, h6)")
    );
    for (const heading of headings) {
      heading.classList.add("group");

      // A link's name joins its heading's name, so the heading is named by
      // its text alone – see "After the article" in docs/patterns/post-page.md.
      // Heading ids are lowercase slugs, so the capital keeps this id from
      // matching another heading's.
      const headingText = document.createElement("span");
      headingText.id = `${heading.id}-Text`;
      headingText.append(...heading.childNodes);
      heading.appendChild(headingText);
      heading.setAttribute("aria-labelledby", headingText.id);

      const link = document.createElement("a");
      link.className =
        "heading-link interactive ms-2 text-foreground/60 no-underline transition-[color,opacity] pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:focus-visible:opacity-100";
      link.href = "#" + heading.id;
      link.setAttribute(
        "aria-label",
        `Link to section: ${headingText.textContent.trim()}`
      );

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const resetTimers = new WeakMap();
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      // The button is absolutely positioned, so the block needs a positioned
      // ancestor – hence the wrapper inserted below.
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // src/utils/transformers/fileName.js sets --file-name-offset on every
      // code block it processes. Reusing it puts the button on the same line
      // as a file label, where one is rendered.
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} interactive rounded bg-muted border border-muted px-2 py-1 font-mono text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      copyButton.setAttribute("aria-live", "polite");
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      let copied = true;
      try {
        await navigator.clipboard.writeText(text ?? "");
      } catch {
        copied = false;
      }

      button.innerText = copied ? "Copied" : "Copy failed";

      // A failure label has to be read, so it holds for longer. A repeat
      // click cancels the last reset, so it can't cut the new label short.
      clearTimeout(resetTimers.get(button));
      resetTimers.set(
        button,
        setTimeout(
          () => {
            button.innerText = copyButtonLabel;
          },
          copied ? 700 : 1500
        )
      );
    }
  }
  attachCopyButtons();

  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
