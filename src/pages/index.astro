---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import LedgerRow from "@/components/LedgerRow.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import avatar from "@/assets/images/avatar.jpeg";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
// Lowest featuredOrder first. Posts without one follow, in date order, which
// the stable sort keeps from sortedPosts.
const featuredOrder = ({ data }: (typeof posts)[number]) =>
  data.featuredOrder ?? Number.MAX_SAFE_INTEGER;
const featuredPosts = sortedPosts
  .filter(({ data }) => data.featured)
  .sort((a, b) => featuredOrder(a) - featuredOrder(b));
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section id="hero" class="pt-7 pb-6 sm:pt-14">
      <!-- One block at both widths: on a phone the portrait shares a row with
      the mono line, and from 640px it stands beside the text -->
      <div
        class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 gap-y-4 [grid-template-areas:'portrait_eyebrow'_'title_title'_'sub_sub'_'lede_lede'] sm:grid-cols-[minmax(0,1fr)_auto] sm:grid-rows-[auto_auto_auto_1fr] sm:items-start sm:gap-x-10 sm:[grid-template-areas:'eyebrow_portrait'_'title_portrait'_'sub_portrait'_'lede_portrait']"
      >
        <p class="eyebrow [grid-area:eyebrow]">Showing my working.</p>
        <h1 class="mt-1 title-hero [grid-area:title] sm:mt-0">
          Building Fidero entirely with AI agents
        </h1>
        <!-- The rest of the headline's sentence, so the two read as one -->
        <p
          class="-mt-2 text-[1.0625rem] leading-[1.45] font-medium [grid-area:sub] sm:text-xl sm:leading-[1.4]"
        >
          the code, the audits, the strategy, the sales
        </p>
        <p
          class="text-[1.0625rem] leading-[1.6] text-foreground/82 [grid-area:lede] sm:text-lg sm:leading-[1.6]"
        >
          <a href="https://fidero.com" class="interactive link-underline"
            >Fidero</a
          > is a data platform for companies whose deals close in a CRM, or whose
          subscriptions start in an app or a billing tool. The same discipline that
          makes customer data trustworthy makes AI agents reliable. I write about
          both.
        </p>
        <Image
          src={avatar}
          alt="Dan Hopwood"
          width={352}
          height={352}
          sizes="(min-width: 640px) 176px, 64px"
          loading="eager"
          class="size-16 flex-none rounded-2xl ring-1 ring-border [grid-area:portrait] sm:size-44 sm:rounded-[1.75rem]"
        />
      </div>
      <div class="mt-8 sm:mt-10">
        <NewsletterSignup variant="row" />
      </div>
      <LedgerRow label="Advisory" class="mt-6 pt-6">
        <p class="text-small leading-normal">
          I also advise founders and leadership teams on AI agents and data.
          <a
            href="https://cal.com/dhpwd/advisory"
            class="whitespace-nowrap interactive link-underline"
            >Book an advisory intro call</a
          >
        </p>
      </LedgerRow>
      <LedgerRow label="Cloud box" class="mt-6 pt-6">
        <p class="text-small leading-normal">
          I set up always-on servers that keep Claude Code working when your
          laptop's shut.
          <a
            href="/cloud-box-setup"
            class="whitespace-nowrap interactive link-underline"
            >See the cloud box setup</a
          >
        </p>
      </LedgerRow>
    </section>

    {
      featuredPosts.length > 0 && (
        <LedgerRow as="section" id="featured" label="Featured" class="py-6">
          <ul class="flex flex-col gap-7">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </LedgerRow>
      )
    }

    {
      recentPosts.length > 0 && (
        <LedgerRow
          as="section"
          id="recent-posts"
          label="Recent posts"
          class="py-6"
        >
          <div>
            <ul class="flex flex-col gap-7">
              {recentPosts.slice(0, SITE.postPerIndex).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
            <LinkButton href="/posts" class="mt-7 mb-6">
              All posts
              <IconArrowRight
                class="icon-step-forward inline-block rtl:-rotate-180"
                aria-hidden="true"
              />
            </LinkButton>
          </div>
        </LedgerRow>
      )
    }
  </main>
  <Footer />
</Layout>
