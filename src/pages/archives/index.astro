---
import { type CollectionEntry, getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LedgerRow from "@/components/LedgerRow.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import postFilter from "@/utils/postFilter";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = await getCollection("blog", postFilter);

// pubDatetime in the timezone Datetime.astro shows dates in, not the build
// machine's
const published = ({ data }: CollectionEntry<"blog">) =>
  dayjs(data.pubDatetime).tz(data.timezone || SITE.timezone);

const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
---

<Layout title={`Archives | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="Archives"
    eyebrow={`${posts.length} ${posts.length === 1 ? "post" : "posts"}`}
  >
    {
      Object.entries(
        getPostsByGroupCondition(posts, post => published(post).year())
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <section class="mb-10">
            <h2 class="flex items-baseline gap-2 pb-4 title-item">
              {year}
              <span class="meta font-normal">{yearGroup.length}</span>
            </h2>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => published(post).month() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <LedgerRow
                  label={months[Number(month) - 1]}
                  level={3}
                  class="py-6"
                >
                  <ul class="flex flex-col gap-7">
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <Card variant="h4" {...data} />
                      ))}
                  </ul>
                </LedgerRow>
              ))}
          </section>
        ))
    }
  </Main>
  <Footer />
</Layout>
