---
import "@pagefind/default-ui/css/ui.css";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`Search | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Search">
    <div id="pagefind-search"></div>
  </Main>
  <Footer />
</Layout>

<script>
  // A Back, Forward or reload to /search restores the saved position before
  // the results render, so the restore is clamped to the short page. Hold
  // the position and how many results were showing, and apply them once the
  // results have loaded – see "Scroll position and View Transitions" in
  // docs/patterns/astro-build.md.
  type Restore = { y: number; shown: number };
  let pending: Restore | null = null;
  let held: Restore | null = null;
  let observer: MutationObserver | undefined;

  // The search root whose page is current. On a Back or Forward the browser
  // moves location and history.state to the entry being moved to before
  // astro:before-preparation, while the old root stays in the page until
  // the swap, so live is cleared there. A link moves the URL only at the
  // swap, where initSearch replaces live. Every write to the history entry
  // but the skip listener's put-back names the root it came from and is
  // dropped unless that root is live.
  let live: HTMLElement | null = null;

  function replaceEntry(root: Element | null, state: unknown, url?: string) {
    if (root && root === live) history.replaceState(state, "", url);
  }

  function savedRestore(): Restore | null {
    const { scrollY: y = 0, searchShown: shown = 0 } = history.state ?? {};
    return y > 0 || shown > 0 ? { y, shown } : null;
  }

  function cancelRestore() {
    pending = null;
    observer?.disconnect();
    observer = undefined;
  }

  function restoreWhenLoaded(root: HTMLElement) {
    if (!pending) return;
    const check = () => {
      if (!pending) return cancelRestore();
      const results = root.querySelectorAll(".pagefind-ui__result");
      if (!results.length) return;
      // Pagefind shows "Load more results" before the excerpts have loaded,
      // so each page is revealed at once and their excerpts load together.
      const more = root.querySelector<HTMLButtonElement>(
        ".pagefind-ui__button"
      );
      if (results.length < pending.shown && more) return more.click();
      if (root.querySelector(".pagefind-ui__loading")) return;
      window.scrollTo({ top: pending.y, behavior: "instant" });
      cancelRestore();
    };
    observer = new MutationObserver(check);
    observer.observe(root, { childList: true, subtree: true });
  }

  // A visitor who scrolls or acts before the results load keeps their place.
  for (const type of ["wheel", "touchstart", "keydown", "pointerdown"])
    window.addEventListener(type, cancelRestore, { passive: true });

  // Pagefind doesn't keep how many results "Load more results" revealed, so
  // keep the count on this history entry each time it grows, and drop it
  // when the visitor types a new search, which starts again at one page.
  // triggerSearch fills the field without an input event.
  document.addEventListener("input", event => {
    const target = event.target as Element;
    if (
      history.state?.searchShown &&
      target.matches("#pagefind-search .pagefind-ui__search-input")
    )
      replaceEntry(target.closest("#pagefind-search"), {
        ...history.state,
        searchShown: 0,
      });
  });

  document.addEventListener("click", event => {
    const button = (event.target as Element).closest?.(
      "#pagefind-search .pagefind-ui__button"
    );
    if (!button) return;
    const root = button.closest("#pagefind-search");
    requestAnimationFrame(() => {
      const shown = document.querySelectorAll(
        "#pagefind-search .pagefind-ui__result"
      ).length;
      replaceEntry(root, { ...history.state, searchShown: shown });
    });
  });

  // The router judges an in-page link against the URL it last navigated to,
  // not the one processTerm writes, so after a search it would fetch /search
  // again for "Skip to content". Move to the fragment in place instead,
  // keeping this entry and its state – see "In-page links after
  // replaceState" in docs/patterns/astro-build.md.
  document.addEventListener(
    "click",
    event => {
      const link = (event.target as Element).closest?.('a[href^="#"]');
      if (
        !(link instanceof HTMLAnchorElement) ||
        !live ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      event.preventDefault();
      const { state } = history;
      location.replace(link.href);
      // A fragment navigation leaves the entry with no state. Put it back
      // directly, not through replaceEntry: this is the entry's own state,
      // and the router ignores a popstate to an entry with null state.
      if (!history.state) history.replaceState(state, "");
    },
    { capture: true }
  );

  // On a Back or Forward, drop this page's root here, since anything it did
  // now would land on the entry being moved to. End any restore still
  // waiting on the page being left. Read the saved position as a Back or
  // Forward to /search starts, and apply it at the swap.
  document.addEventListener(
    "astro:before-preparation",
    ({ navigationType, to }) => {
      if (navigationType === "traverse") live = null;
      cancelRestore();
      held =
        navigationType === "traverse" && to.pathname === "/search"
          ? savedRestore()
          : null;
    }
  );

  document.addEventListener("astro:before-swap", () => {
    pending = held;
  });

  // On the first run, whether a full load or the first client-side visit,
  // history.state holds a saved position only on a Back, Forward or reload.
  pending = savedRestore();

  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    live = pageFindSearch;
    if (!pageFindSearch) return;

    const params = new URLSearchParams(window.location.search);

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // A Back or Forward started, or another swap replaced this root, during
      // the idle wait and import. The run for the new root mounts the UI.
      if (pageFindSearch !== live) return;

      // Pagefind indexes the built site, so dev has no index to search.
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
            <div class="bg-muted/75 rounded p-4 space-y-4 mb-4">
              <p><strong>DEV mode Warning! </strong>You need to build the project at least once to see the search results during development.</p>
              <code class="block bg-black text-white px-2 py-1 rounded">pnpm run build</code>
            </div>
          `;
      }

      const search = new PagefindUI({
        element: "#pagefind-search",
        showImages: false,
        showSubResults: true,
        processTerm: function (term: string) {
          // Mirror the term into the URL so a search is linkable, without
          // adding a history entry per keystroke. Pagefind searches a
          // whitespace-only term too, which leaves no q.
          if (!term.trim()) clearQuery();
          else {
            params.set("q", term);
            replaceEntry(
              pageFindSearch,
              history.state,
              "?" + params.toString()
            );
          }

          return term;
        },
      });

      const query = params.get("q");
      if (query?.trim()) {
        restoreWhenLoaded(pageFindSearch);
        search.triggerSearch(query);
      } else {
        pending = null;
        if (query !== null) clearQuery();
      }

      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      searchInput?.addEventListener("input", event => {
        if (!(event.target as HTMLInputElement).value.trim()) clearQuery();
      });
      // Pagefind empties the field on Clear and on Escape without an input
      // event.
      clearButton?.addEventListener("click", clearQuery);
      searchInput?.addEventListener("keydown", event => {
        if ((event as KeyboardEvent).key === "Escape") clearQuery();
      });

      // Remove q and keep the other parameters, so the URL stays in step
      // with the params processTerm writes from. It writes even with no q
      // to remove, so a clear also drops the skip link's hash, which a Back
      // then Forward would otherwise reach without a live root – see
      // "Client scripts and View Transitions" in docs/patterns/astro-build.md.
      function clearQuery() {
        params.delete("q");
        const rest = params.toString();
        replaceEntry(
          pageFindSearch,
          history.state,
          rest ? "?" + rest : window.location.pathname
        );
      }
    });
  }

  document.addEventListener("astro:after-swap", initSearch);
  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--foreground);
    }

    /* Field contrast – see "Form fields" in docs/patterns/design-system.md */
    input {
      font-weight: 400;
      border-color: color-mix(in srgb, var(--foreground) 60%, transparent);
      transition-property: border-color, box-shadow;
      transition-duration: var(--default-transition-duration);
      transition-timing-function: var(--default-transition-timing-function);
    }

    input::placeholder {
      opacity: 1;
      color: color-mix(in srgb, var(--foreground) 75%, transparent);
    }

    input:focus {
      border-color: var(--foreground);
      box-shadow: 0 0 0 1px var(--foreground);
      outline: 2px solid transparent;
    }

    .pagefind-ui__result-title a {
      color: var(--foreground);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }

  /* Interaction states and palette – see "One interaction behaviour" in
     docs/patterns/design-system.md */
  #pagefind-search .pagefind-ui__result-link,
  #pagefind-search .pagefind-ui__search-clear,
  #pagefind-search .pagefind-ui__button {
    transition-property: color, border-color;
    transition-duration: var(--default-transition-duration);
    transition-timing-function: var(--default-transition-timing-function);
  }

  #pagefind-search .pagefind-ui__search-clear:focus-visible,
  #pagefind-search .pagefind-ui__button:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 1px;
  }

  #pagefind-search .pagefind-ui__button {
    color: var(--foreground);
    border-color: color-mix(in srgb, var(--foreground) 60%, transparent);
  }

  /* Pagefind's reset leaves result links and Clear with no border, so the
     border step reaches "Load more results" only. */
  @media (hover: hover) {
    #pagefind-search .pagefind-ui__result-link:hover,
    #pagefind-search .pagefind-ui__search-clear:hover,
    #pagefind-search .pagefind-ui__button:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
  }

  #pagefind-search .pagefind-ui__result-link:active,
  #pagefind-search .pagefind-ui__search-clear:active,
  #pagefind-search .pagefind-ui__button:active {
    color: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  #pagefind-search mark {
    color: inherit;
    background-color: var(--accent-tint);
  }

  /* Type on the site's scale – see "Type" in docs/patterns/design-system.md.
     Pagefind sizes its text at 80% of its own scale, which puts an excerpt
     at 12.8px. */
  #pagefind-search .pagefind-ui__message {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--foreground) 75%, transparent);
  }

  #pagefind-search .pagefind-ui__result-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  /* The link too, since Pagefind sets a nested result's link at 0.9em */
  #pagefind-search .pagefind-ui__result-nested .pagefind-ui__result-title,
  #pagefind-search .pagefind-ui__result-nested .pagefind-ui__result-link {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  #pagefind-search .pagefind-ui__result-excerpt {
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
