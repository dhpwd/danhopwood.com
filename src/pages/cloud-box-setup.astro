---
import { PUBLIC_WEB3FORMS_ACCESS_KEY } from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const heading = "Claude Code that keeps working when your laptop is shut";
const opening =
  "I'll set up an always-on server for you that runs Claude Code with your repos, skills and connectors on it. You start sessions and pick them up from the Claude app on your laptop or your phone.";

// One row per place. Changing a place's status is a one-line edit here: the
// table and its chip style both follow from it. The empty status marks the
// regular-price row.
type Place = {
  place: string;
  price: string;
  status: "Held" | "Open" | "Taken" | "";
};

const places: Place[] = [
  { place: "First", price: "£350", status: "Held" },
  { place: "Second", price: "£500", status: "Open" },
  { place: "Third", price: "£650", status: "Open" },
  { place: "After that", price: "£950", status: "" },
];

const chipClass = {
  Open: "border-accent text-accent",
  Held: "border-border bg-muted text-foreground/75",
  Taken: "border-border bg-muted text-foreground/75",
};

const sectionClass = "flex flex-col gap-5 border-t border-border pt-8";
const labelClass =
  "font-mono text-[0.8125rem] font-medium tracking-[0.04em] uppercase";
const listClass = "flex flex-col gap-2.5 pl-5 marker:text-accent";
const inputClass =
  "w-full rounded border border-border bg-background px-3 py-2 text-base text-foreground placeholder:opacity-50 focus:border-accent focus:outline-none sm:text-sm";
---

<Layout title={`${heading} | ${SITE.title}`} description={opening}>
  <Header />
  <main id="main-content" class="app-layout">
    <div
      class="flex flex-col gap-10 pt-9 pb-12 text-[1.0625rem] leading-[1.6] sm:gap-12 sm:pt-14 sm:pb-16"
    >
      <div class="flex flex-col gap-5">
        <p class="font-mono text-[0.8125rem] tracking-[0.02em] text-accent">
          Dan Hopwood · done-for-you setup
        </p>
        <h1
          class="text-[clamp(1.75rem,5.2vw,2.5rem)] leading-[1.15] font-semibold text-balance"
        >
          {heading}
        </h1>
        <p class="max-w-[38rem] text-[1.1875rem] leading-[1.55]">{opening}</p>
      </div>

      <section aria-labelledby="shift-h" class={sectionClass}>
        <h2 id="shift-h" class="text-xl leading-[1.3] font-semibold">
          What changes
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div
            class="flex min-w-0 flex-col gap-2 rounded-md border border-border px-5 py-[1.125rem]"
          >
            <h3 class:list={[labelClass, "text-foreground/75"]}>Today</h3>
            <p>
              Your agents only run while your laptop is open and online. Close
              the lid part-way through a long job and the job stops.
            </p>
          </div>
          <div
            class="flex min-w-0 flex-col gap-2 rounded-md border border-accent px-5 py-[1.125rem]"
          >
            <h3 class:list={[labelClass, "text-accent"]}>After</h3>
            <p>
              The work runs on a server that never sleeps. Close the lid, get on
              a train, open the Claude app on your phone and carry on in the
              same session.
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="get-h" class={sectionClass}>
        <h2 id="get-h" class="text-xl leading-[1.3] font-semibold">
          What you get
        </h2>
        <ul class:list={[listClass, "list-disc"]}>
          <li>
            A server in your own account, running Claude Code all the time on
            your own Claude subscription
          </li>
          <li>
            Sessions you start and continue from the Claude desktop and phone
            apps. You never need a terminal
          </li>
          <li>
            Your GitHub repos on it with their dependencies installed, and your
            skills, agents and settings copied from your laptop
          </li>
          <li>Your connectors working there too</li>
          <li>
            Nothing on the server is reachable from the public internet, the
            agents can't give themselves admin rights and security updates
            install themselves
          </li>
          <li>
            A 45-minute handover call where we get it running from your phone
          </li>
          <li>14 days of fixes after the call</li>
        </ul>
      </section>

      <section aria-labelledby="how-h" class={sectionClass}>
        <h2 id="how-h" class="text-xl leading-[1.3] font-semibold">
          How it works
        </h2>
        <ol
          class:list={[
            listClass,
            "list-decimal marker:font-mono marker:text-[0.9375rem]",
          ]}
        >
          <li>
            <strong class="font-semibold">You order the server.</strong> It takes
            about 10 minutes with the steps I send you. It goes in your own account
            with the host, and you pay them about €31 a month
          </li>
          <li>
            <strong class="font-semibold">I build it.</strong> The build runs from
            public scripts, so you can read what gets installed on your server
          </li>
          <li>
            <strong class="font-semibold">We do one 45-minute call.</strong> You sign
            in to your own accounts (Claude, GitHub, your connectors) and I move your
            setup across. By the end you'll have a session running from your phone
            with your laptop shut
          </li>
          <li>
            <strong class="font-semibold">I remove my access.</strong> The server
            and every account it uses are yours, and nothing about it depends on me
          </li>
        </ol>
      </section>

      <section aria-labelledby="why-h" class={sectionClass}>
        <h2 id="why-h" class="text-xl leading-[1.3] font-semibold">
          Why a server
        </h2>
        <ul class:list={[listClass, "list-disc"]}>
          <li>
            <strong class="font-semibold">A keep-awake app</strong> works while the
            laptop sits on your desk. Once it goes in a bag there's no wifi, and the
            agents stop
          </li>
          <li>
            <strong class="font-semibold">A Mac mini at home</strong> does the same
            job, but you buy the machine and set up the remote access yourself
          </li>
          <li>
            <strong class="font-semibold">Cloud coding sessions</strong> start from
            a copy of one GitHub repo. They don't have your connectors, your other
            repos or anything else from your own setup
          </li>
        </ul>
      </section>

      <section aria-labelledby="price-h" class={sectionClass}>
        <h2 id="price-h" class="text-xl leading-[1.3] font-semibold">Price</h2>
        <p>
          The price is one-off, plus VAT. The first three places are at a
          founding price, because you'd be among the first people I've set this
          up for and I'll ask for your feedback on how it went.
        </p>
        <table class="w-full border-collapse tabular-nums">
          <thead>
            <tr>
              {
                ["Place", "Price", "Status"].map(column => (
                  <th
                    scope="col"
                    class:list={[
                      labelClass,
                      "border-b border-border py-3 pr-2 text-left text-foreground/75 last:pr-0 last:text-right",
                    ]}
                  >
                    {column}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              places.map(({ place, price, status }) => (
                <tr class:list={{ "text-foreground/75": !status }}>
                  <td class="border-b border-border py-3 pr-2">{place}</td>
                  <td
                    class:list={[
                      "border-b border-border py-3 pr-2 font-mono",
                      status
                        ? "text-[1.375rem] font-semibold tracking-[-0.02em]"
                        : "text-lg font-medium",
                    ]}
                  >
                    {price}
                  </td>
                  <td class="border-b border-border py-3 text-right">
                    {status && (
                      <span
                        class:list={[
                          "inline-block rounded-full border px-2 py-[0.1875rem] font-mono text-xs tracking-[0.04em] uppercase",
                          chipClass[status],
                        ]}
                      >
                        {status}
                      </span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
          <div class="flex min-w-0 flex-col gap-1.5">
            <h3 class:list={[labelClass, "text-foreground/75"]}>Timing</h3>
            <p>I'll offer you a call within a week of payment.</p>
          </div>
          <div class="flex min-w-0 flex-col gap-1.5">
            <h3 class:list={[labelClass, "text-foreground/75"]}>
              Holding a place
            </h3>
            <p>
              A yes holds your place for 48 hours from when I send the invoice.
              Work starts once it's paid.
            </p>
          </div>
          <div class="flex min-w-0 flex-col gap-1.5">
            <h3 class:list={[labelClass, "text-foreground/75"]}>Guarantee</h3>
            <p>
              If you can't operate Claude Code from your phone with your laptop
              shut once we're done, I refund you in full.
            </p>
          </div>
          <div class="flex min-w-0 flex-col gap-1.5">
            <h3 class:list={[labelClass, "text-foreground/75"]}>
              Running costs
            </h3>
            <p>
              You pay for the server, about €31 a month on a one-month contract,
              and for your Claude plan, both direct.
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="need-h" class={sectionClass}>
        <h2 id="need-h" class="text-xl leading-[1.3] font-semibold">
          What you need
        </h2>
        <ul class:list={[listClass, "list-disc"]}>
          <li>A paid Claude plan</li>
          <li>Your work in GitHub</li>
          <li>The Claude app on your phone</li>
        </ul>
        <p class="text-[0.9375rem] text-foreground/75">
          The fixed price covers up to 10 repos and 5 connectors that use their
          own API keys. It doesn't cover maintenance after the 14 days, or
          designing and building agents, skills or loops. That's separate work,
          so ask me if you want it.
        </p>
      </section>

      <section
        aria-labelledby="cta-h"
        class="flex flex-col gap-1.5 rounded-md border border-accent px-[1.375rem] py-5"
      >
        <h2 id="cta-h" class="text-xl leading-[1.3] font-semibold">
          Get it set up
        </h2>
        <p>
          Tell me what you'd want running on it and I'll email you back to see
          if it fits.
        </p>
        <!-- Posts natively to Web3Forms when JavaScript is off, and inline
        through the script below otherwise – see docs/external-services.md -->
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="mt-3 flex flex-col gap-4"
          data-setup-form
        >
          <input
            type="hidden"
            name="access_key"
            value={PUBLIC_WEB3FORMS_ACCESS_KEY}
          />
          <input
            type="hidden"
            name="subject"
            value="Cloud box setup enquiry via danhopwood.com"
          />
          <input type="hidden" name="from_name" value="danhopwood.com" />
          <input
            type="checkbox"
            name="botcheck"
            class="absolute -left-[9999px]"
            aria-hidden="true"
            tabindex="-1"
            autocomplete="off"
          />
          <div class="flex flex-col gap-1.5">
            <label for="setup-name" class="font-mono text-sm">Name</label>
            <input
              id="setup-name"
              type="text"
              name="name"
              autocomplete="name"
              required
              class={inputClass}
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="setup-email" class="font-mono text-sm">Email</label>
            <input
              id="setup-email"
              type="email"
              name="email"
              autocomplete="email"
              required
              class={inputClass}
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="setup-message" class="font-mono text-sm"
              >What you'd want running on it</label
            >
            <textarea
              id="setup-message"
              name="message"
              rows="4"
              placeholder="e.g. 4 repos, Linear and Slack connectors, agents that review PRs while I'm away"
              required
              class={inputClass}></textarea>
          </div>
          <div class="flex flex-col items-start gap-2">
            <button
              type="submit"
              class="rounded bg-accent px-4 py-2 text-sm font-medium text-background hover:opacity-90 disabled:opacity-60"
            >
              Request setup
            </button>
            <p class="text-sm" role="status" data-setup-status></p>
          </div>
        </form>
      </section>

      <p
        class="border-t border-border pt-6 text-[0.9375rem] text-foreground/75"
      >
        How the setup works and why I run mine this way:
        <a
          href="/posts/running-coding-agents-on-a-30-euro-linux-box"
          class="text-foreground underline decoration-dashed underline-offset-4 hover:text-accent"
          >Running coding agents on a €30 Linux box</a
        >.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const SUCCESS_LINE =
    "Thanks, that's with me. I'll reply by email, and nothing's booked until I send the invoice.";

  function showFailure(status: Element) {
    // A new tab, so the text the visitor typed survives
    const link = document.createElement("a");
    link.href = "https://www.linkedin.com/in/dhpwd";
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.className =
      "underline decoration-dashed underline-offset-4 hover:text-accent";
    link.textContent = "LinkedIn";
    status.replaceChildren(
      "That didn't send. Try again, or message me on ",
      link,
      "."
    );
  }

  // Web3Forms answers a successful submit with 200 and `success: true`.
  // Anything else, an unparseable body or a thrown fetch (network error,
  // timeout, no AbortSignal.timeout) counts as a failure. Never send a
  // `redirect` field from here – see docs/external-services.md.
  async function send(form: HTMLFormElement) {
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
        signal: AbortSignal.timeout(10000),
      });
      if (!response.ok) return false;
      const result = await response.json();
      return result?.success === true;
    } catch {
      return false;
    }
  }

  function initSetupForms() {
    document
      .querySelectorAll<HTMLFormElement>("form[data-setup-form]")
      .forEach(form => {
        if (form.dataset.initialized) return;
        form.dataset.initialized = "true";

        const button = form.querySelector<HTMLButtonElement>(
          "button[type=submit]"
        )!;
        const status = form.querySelector("[data-setup-status]")!;

        form.addEventListener("submit", async event => {
          event.preventDefault();
          // Disabling the focused button drops focus to <body>, so focus goes
          // back to the button once it's enabled, on both the click and the
          // Enter-in-a-field routes
          button.disabled = true;
          status.textContent = "";

          const ok = await send(form);

          button.disabled = false;
          if (ok) {
            form.reset();
            status.textContent = SUCCESS_LINE;
          } else {
            showFailure(status);
          }
          button.focus();
        });
      });
  }

  // The client router swaps the DOM without re-running this module, so the
  // listener has to be re-attached per navigation.
  document.addEventListener("astro:page-load", initSetupForms);
</script>
