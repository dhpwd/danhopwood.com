---
import { PUBLIC_WEB3FORMS_ACCESS_KEY } from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageIntro from "@/components/PageIntro.astro";
import Section from "@/components/Section.astro";
import Panel from "@/components/Panel.astro";
import Detail from "@/components/Detail.astro";
import MarkedList from "@/components/MarkedList.astro";
import StatusChip from "@/components/StatusChip.astro";
import Field from "@/components/Field.astro";
import Button from "@/components/Button.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const linkedIn = SOCIALS.find(({ name }) => name === "LinkedIn")!.href;

const heading = "Claude Code that keeps working when your laptop is shut";
const opening =
  "I'll set up an always-on server for you that runs Claude Code with your repos, skills and connectors on it. You start sessions and pick them up from the Claude app on your laptop or your phone.";

// One row per place. Changing a place's status is a one-line edit here: the
// table and its chip both follow from it. The empty status marks the
// regular-price row.
type Place = {
  place: string;
  price: string;
  status: "Held" | "Open" | "Taken" | "";
};

const places: Place[] = [
  { place: "First", price: "£350", status: "Held" },
  { place: "Second", price: "£500", status: "Open" },
  { place: "Third", price: "£650", status: "Open" },
  { place: "After that", price: "£950", status: "" },
];
---

<Layout title={`${heading} | ${SITE.title}`} description={opening}>
  <Header />
  <main id="main-content" class="app-layout">
    <div
      class="flex flex-col gap-10 pt-9 pb-12 text-[1.0625rem] leading-[1.6] sm:gap-12 sm:pt-14 sm:pb-16"
    >
      <PageIntro eyebrow="Done-for-you setup" title={heading}>
        {opening}
      </PageIntro>

      <Section id="shift" title="What changes">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Panel label="Today">
            <p>
              Your agents only run while your laptop is open and online. Close
              the lid part-way through a long job and the job stops.
            </p>
          </Panel>
          <Panel label="After" strong>
            <p>
              The work runs on a server that never sleeps. Close the lid, get on
              a train, open the Claude app on your phone and carry on in the
              same session.
            </p>
          </Panel>
        </div>
      </Section>

      <Section id="get" title="What you get">
        <MarkedList>
          <li>
            A server in your own account, running Claude Code all the time on
            your own Claude subscription
          </li>
          <li>
            Sessions you start and continue from the Claude desktop and phone
            apps. You never need a terminal
          </li>
          <li>
            Your GitHub repos on it with their dependencies installed, and your
            skills, agents and settings copied from your laptop
          </li>
          <li>Your connectors working there too</li>
          <li>
            Nothing on the server is reachable from the public internet, the
            agents can't give themselves admin rights and security updates
            install themselves
          </li>
          <li>
            A 45-minute handover call where we get it running from your phone
          </li>
          <li>14 days of fixes after the call</li>
        </MarkedList>
      </Section>

      <Section id="how" title="How it works">
        <MarkedList ordered>
          <li>
            <strong class="font-semibold">You order the server.</strong> It takes
            about 10 minutes with the steps I send you. It goes in your own account
            with the host, and you pay them about €31 a month
          </li>
          <li>
            <strong class="font-semibold">I build it.</strong> The build runs from
            public scripts, so you can read what gets installed on your server
          </li>
          <li>
            <strong class="font-semibold">We do one 45-minute call.</strong> You sign
            in to your own accounts (Claude, GitHub, your connectors) and I move your
            setup across. By the end you'll have a session running from your phone
            with your laptop shut
          </li>
          <li>
            <strong class="font-semibold">I remove my access.</strong> The server
            and every account it uses are yours, and nothing about it depends on me
          </li>
        </MarkedList>
      </Section>

      <Section id="why" title="Why a server">
        <MarkedList>
          <li>
            <strong class="font-semibold">A keep-awake app</strong> works while the
            laptop sits on your desk. Once it goes in a bag there's no wifi, and the
            agents stop
          </li>
          <li>
            <strong class="font-semibold">A Mac mini at home</strong> does the same
            job, but you buy the machine and set up the remote access yourself
          </li>
          <li>
            <strong class="font-semibold">Cloud coding sessions</strong> start from
            a copy of one GitHub repo. They don't have your connectors, your other
            repos or anything else from your own setup
          </li>
        </MarkedList>
      </Section>

      <Section id="price" title="Price">
        <p>
          The price is one-off, plus VAT. The first three places are at a
          founding price, because you'd be among the first people I've set this
          up for and I'll ask for your feedback on how it went.
        </p>
        <table class="w-full border-collapse tabular-nums">
          <thead>
            <tr>
              {
                ["Place", "Price", "Status"].map(column => (
                  <th
                    scope="col"
                    class="border-b border-border py-3 pr-2 text-left label-caps text-foreground/75 last:pr-0 last:text-right"
                  >
                    {column}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              places.map(({ place, price, status }) => (
                <tr class:list={{ "text-foreground/75": !status }}>
                  <td class="border-b border-border py-3 pr-2">{place}</td>
                  <td
                    class:list={[
                      "border-b border-border py-3 pr-2 font-mono",
                      status
                        ? "text-[1.375rem] font-semibold tracking-[-0.02em]"
                        : "text-lg font-medium",
                    ]}
                  >
                    {price}
                  </td>
                  <td class="border-b border-border py-3 text-right">
                    {status && <StatusChip {status} />}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
          <Detail label="Timing">
            <p>I'll offer you a call within a week of payment.</p>
          </Detail>
          <Detail label="Holding a place">
            <p>
              A yes holds your place for 48 hours from when I send the invoice.
              Work starts once it's paid.
            </p>
          </Detail>
          <Detail label="Guarantee">
            <p>
              If you can't operate Claude Code from your phone with your laptop
              shut once we're done, I refund you in full.
            </p>
          </Detail>
          <Detail label="Running costs">
            <p>
              You pay for the server, about €31 a month on a one-month contract,
              and for your Claude plan, both direct.
            </p>
          </Detail>
        </div>
      </Section>

      <Section id="need" title="What you need">
        <MarkedList>
          <li>A paid Claude plan</li>
          <li>Your work in GitHub</li>
          <li>The Claude app on your phone</li>
        </MarkedList>
        <p class="text-small text-foreground/75">
          The fixed price covers up to 10 repos and 5 connectors that use their
          own API keys. It doesn't cover maintenance after the 14 days, or
          designing and building agents, skills or loops. That's separate work,
          so ask me if you want it.
        </p>
      </Section>

      <Section id="cta" title="Get it set up" framed>
        <p>
          Tell me what you'd want running on it and I'll email you back to see
          if it fits.
        </p>
        <!-- Posts natively to Web3Forms when JavaScript is off, and inline
        through the script below otherwise – see docs/external-services.md -->
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="mt-3 flex flex-col gap-4"
          data-setup-form
          data-linkedin={linkedIn}
        >
          <input
            type="hidden"
            name="access_key"
            value={PUBLIC_WEB3FORMS_ACCESS_KEY}
          />
          <input
            type="hidden"
            name="subject"
            value="Cloud box setup enquiry via danhopwood.com"
          />
          <input type="hidden" name="from_name" value="danhopwood.com" />
          <input
            type="checkbox"
            name="botcheck"
            class="absolute -left-[9999px]"
            aria-hidden="true"
            tabindex="-1"
            autocomplete="off"
          />
          <Field
            id="setup-name"
            name="name"
            label="Name"
            autocomplete="name"
            required
          />
          <Field
            id="setup-email"
            name="email"
            label="Email"
            type="email"
            autocomplete="email"
            required
          />
          <Field
            id="setup-message"
            name="message"
            label="What you'd want running on it"
            rows={4}
            placeholder="e.g. 4 repos, Linear and Slack connectors, agents that review PRs while I'm away"
            required
          />
          <div class="flex flex-col items-start gap-2">
            <Button type="submit">Request setup</Button>
            <p class="text-sm" role="status" data-setup-status></p>
          </div>
        </form>
      </Section>

      <p class="border-t border-border pt-6 text-small text-foreground/75">
        How the setup works and why I run mine this way:
        <a
          href="/posts/running-coding-agents-on-a-30-euro-linux-box"
          class="interactive text-foreground link-underline"
          >Running coding agents on a €30 Linux box</a
        >.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const SUCCESS_LINE =
    "Thanks, that's with me. I'll reply by email, and nothing's booked until I send the invoice.";

  function showFailure(status: Element, linkedIn: string) {
    // A new tab, so the text the visitor typed survives
    const link = document.createElement("a");
    link.href = linkedIn;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.className = "interactive link-underline";
    link.textContent = "LinkedIn";
    status.replaceChildren(
      "That didn't send. Try again, or message me on ",
      link,
      "."
    );
  }

  // Never send a `redirect` field from here – see docs/external-services.md.
  async function send(form: HTMLFormElement) {
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
        // Safari before 16 has no AbortSignal.timeout. There the request runs
        // without a timeout, rather than throwing and failing every submit
        signal: AbortSignal.timeout?.(10000),
      });
      if (!response.ok) return false;
      const result = await response.json();
      return result.success === true;
    } catch {
      return false;
    }
  }

  function initSetupForm() {
    const form = document.querySelector<HTMLFormElement>(
      "form[data-setup-form]"
    );
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = "true";

    const button = form.querySelector<HTMLButtonElement>(
      "button[type=submit]"
    )!;
    const status = form.querySelector("[data-setup-status]")!;

    form.addEventListener("submit", async event => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = "";

      const ok = await send(form);

      button.disabled = false;
      if (ok) {
        form.reset();
        status.textContent = SUCCESS_LINE;
      } else {
        showFailure(status, form.dataset.linkedin!);
      }
      // Focus goes to the button on every route, Enter in a field included –
      // see "Disabling a focused button drops focus" in
      // docs/patterns/client-scripts.md
      button.focus();
    });
  }

  // See "Client scripts and View Transitions" in docs/patterns/client-scripts.md
  document.addEventListener("astro:page-load", initSetupForm);
  initSetupForm();
</script>
