---
import { PUBLIC_WEB3FORMS_ACCESS_KEY } from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageIntro from "@/components/PageIntro.astro";
import Section from "@/components/Section.astro";
import Panel from "@/components/Panel.astro";
import Detail from "@/components/Detail.astro";
import MarkedList from "@/components/MarkedList.astro";
import Questions from "@/components/Questions.astro";
import StatusChip from "@/components/StatusChip.astro";
import Field from "@/components/Field.astro";
import Button from "@/components/Button.astro";
import ServerSessions from "@/components/diagrams/ServerSessions.astro";
import Walkthrough from "@/components/Walkthrough.astro";
import { Image } from "astro:assets";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { clock } from "@/utils/clock";
import walkthroughLaptop from "@/assets/images/cloud-box/walkthrough-laptop.png";
import walkthroughPhone from "@/assets/images/cloud-box/walkthrough-phone.png";
import walkthroughPoster from "@/assets/images/cloud-box/walkthrough-poster.jpg";
import pickerToday from "@/assets/images/cloud-box/picker-today.png";
import pickerAfter from "@/assets/images/cloud-box/picker-after.png";

const linkedIn = SOCIALS.find(({ name }) => name === "LinkedIn")!.href;

const heading = "Claude Code that keeps working when your laptop is shut";
const opening =
  "I'll set up an always-on server for you that runs Claude Code with your repos, skills and connectors on it. You keep working in the Claude app the way you do now, and your whole setup is there on your phone too.";

// One row per place. Changing a place's status is a one-line edit here: the
// table and its chip both follow from it. The empty status marks the
// regular-price row.
type Place = {
  place: string;
  price: string;
  status: "Held" | "Open" | "Taken" | "";
};

const places: Place[] = [
  { place: "First", price: "£350", status: "Held" },
  { place: "Second", price: "£500", status: "Taken" },
  { place: "Third", price: "£650", status: "Open" },
  { place: "After that", price: "£950", status: "" },
];

// The walkthrough's files on Vercel Blob. Each name carries the file's content
// hash, so a new encode is a new URL – see "Vercel Blob" in
// docs/external-services.md.
const blob = "https://pp41erezhiwk0unv.public.blob.vercel-storage.com";
const walkthrough = {
  video: `${blob}/walkthrough/take-1b05858c.mp4`,
  laptop: `${blob}/walkthrough/laptop-15850b5b.mp4`,
  phone: `${blob}/walkthrough/phone-aa92d5c3.mp4`,
};

// Where each beat of the take starts, in seconds
const chapters = [
  { label: "What it is", start: 0 },
  { label: "Why I built it", start: 11.5 },
  { label: "Before and after", start: 61 },
  { label: "On my phone", start: 157.8 },
  { label: "In the web app", start: 201.4 },
  { label: "How I use it", start: 231.4 },
];
const chapterStart = (label: string) =>
  chapters.find(chapter => chapter.label === label)!.start;

const questions = [
  {
    question:
      "Do I have to use a terminal at any point, even during the setup?",
    answer:
      "No. On the handover call you share your screen and (if you're happy to) hand me control of your keyboard for the steps that run on your laptop. You sign in to your own accounts yourself, and after the call everything happens in the Claude app.",
  },
  {
    question: "Can you get into my server afterwards?",
    answer:
      "No. I remove my key at the end of the handover and have no way in after that. You keep the admin login through your host's console, and if something needs fixing in the 14 days we do it on a call while you share your screen.",
  },
  {
    question: "Will it cost me more with Claude?",
    answer:
      "No, the server runs on the Claude subscription you already have, with the same limits. Work on the server counts towards them the same way work on your laptop does.",
  },
  {
    question: "What happens after the 14 days?",
    answer:
      "The server keeps running. It's in your account, security updates install themselves and nothing on it depends on me. If something breaks later, fixing it is separate work, so ask me.",
  },
  {
    question: "Can my team have it?",
    answer:
      "Yes. It's one setup per person, so each of you gets your own server on your own Claude seat. The company can own the hosting account and pay for every server, which lets it keep or close one when someone leaves.",
  },
  {
    question: "Why not a Mac mini, or an app that keeps my laptop awake?",
    answer:
      "A keep-awake app works while the laptop sits on your desk. Once it goes in a bag there's no wifi and the agents stop. A Mac mini at home does the same job as the server, but you'd need to buy one and then set up the remote access yourself.",
  },
  {
    question: "Don't Claude's cloud sessions already do this?",
    answer:
      "For some work they do: a cloud session can hold several GitHub repos and the connectors you've added in claude.ai. It doesn't have what's set up only on your own machine though (skills and agents kept outside your repos, connectors added with their own keys), and it gets shut down when it's been idle for a while, which ends any background work or scheduled jobs it was running. The server, on the other hand, is one machine that stays on and holds your whole setup.",
  },
  {
    question: "Does it run Codex or other agents?",
    answer: "It can do but this setup is Claude Code only, for now.",
  },
  {
    question: "I don't use Claude Code yet. Is this for me?",
    answer:
      "Not yet. The setup moves the repos, skills and connectors you already work with onto a server, so it's for people who use Claude Code day to day.",
  },
];
---

<Layout title={`${heading} | ${SITE.title}`} description={opening}>
  <Header />
  <main id="main-content" class="app-layout">
    <div
      class="flex flex-col gap-10 pt-9 pb-12 text-[1.0625rem] leading-[1.6] sm:gap-12 sm:pt-14 sm:pb-16"
    >
      <PageIntro eyebrow="Done-for-you setup" title={heading}>
        {opening}
      </PageIntro>

      <Walkthrough
        video={walkthrough.video}
        previews={{ laptop: walkthrough.laptop, phone: walkthrough.phone }}
        stills={{ laptop: walkthroughLaptop, phone: walkthroughPhone }}
        poster={walkthroughPoster}
        captions={{ src: "/cloud-box-walkthrough.vtt", label: "English" }}
        length={277}
        chapters={chapters}
        copy={{
          label: "Walkthrough",
          play: "Play",
          playName: "Play the walkthrough",
          laptop: "Laptop",
          phone: "Phone",
          summary:
            'The walkthrough video is a recording of my screen with me talking over it: I start a session in the Claude desktop app and choose a repo on my server instead of "This computer", then reply to the same conversation from my phone, open it in the web app and start more work from the phone.',
        }}
      />

      <Section id="why" title="Why I built this">
        <p>
          I built this for myself first, because I was beholden to my laptop.
        </p>
        <MarkedList>
          <li>
            <strong class="font-semibold"
              >My agents only worked while the laptop was open and on wifi.</strong
            > If I had to leave somewhere soon, I'd either hold off starting a job
            or sit and wait for one to finish. Then nothing got done while I was on
            the move
          </li>
          <li>
            <strong class="font-semibold"
              >Slow or dodgy wifi got in the way.</strong
            > In a cafe, on a train or at an airport it made the work frustrating
            (or impossible)
          </li>
          <li>
            <strong class="font-semibold"
              >I couldn't do much from my phone.</strong
            > It didn't have my full setup, so I couldn't make any real progress standing
            on the tube
          </li>
        </MarkedList>
        <p>
          So I moved everything onto a server that never turns off. My laptop
          and phone are now just windows into it.
        </p>
      </Section>

      <Section id="result" title="What you end up with">
        <p>
          Everything stays in the Claude app. The one difference is where the
          work runs.
        </p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Panel label="Today">
            <Image
              src={pickerToday}
              alt={'The row under the Claude app\'s prompt box, with "This computer" and a folder chosen'}
              sizes="20rem"
              class="w-full rounded-sm border border-foreground/16 dark:brightness-88"
            />
            <p>
              You start a session, choose "This computer" and pick a folder. The
              work runs on your laptop, so it stops when the laptop does.
            </p>
          </Panel>
          <Panel label="After" strong>
            <Image
              src={pickerAfter}
              alt="The same row under the prompt box, with a repo on the server chosen instead"
              sizes="20rem"
              class="w-full rounded-sm border border-foreground/16 dark:brightness-88"
            />
            <p>
              You start a session and choose one of your repos on the server
              instead. Nothing else in the app changes, and the work carries on
              whether your laptop is open or not.
            </p>
          </Panel>
        </div>
        <div class="my-4">
          <ServerSessions />
        </div>
        <MarkedList>
          <li>
            <strong class="font-semibold"
              >Send the message, shut the laptop.</strong
            > The job carries on while the laptop's in your bag
            <a
              href="#walkthrough"
              class="mt-1 block w-fit meta interactive"
              data-walkthrough-at={chapterStart("Before and after")}
              ><span class="link-underline"
                >In the video · {clock(chapterStart("Before and after"))}</span
              ></a
            >
          </li>
          <li>
            <strong class="font-semibold">Pick it up anywhere.</strong> The same conversation,
            with your full setup behind it, is in the Claude app on your phone and
            even in the web app (claude.ai) if you need to use another computer. Reply
            from wherever you are, then carry on at the laptop when you're home
            <a
              href="#walkthrough"
              class="mt-1 block w-fit meta interactive"
              data-walkthrough-at={chapterStart("On my phone")}
              ><span class="link-underline"
                >In the video · {clock(chapterStart("On my phone"))}</span
              ></a
            >
          </li>
          <li>
            <strong class="font-semibold"
              >Bad wifi doesn't slow down the work.</strong
            > A weak connection slows your messages down, but the job itself runs
            on the server
          </li>
          <li>
            <strong class="font-semibold">No terminal.</strong> You never type a command
          </li>
        </MarkedList>
      </Section>

      <Section id="more" title="What else it's good for">
        <MarkedList>
          <li>
            <strong class="font-semibold">One copy of your files.</strong> Every session
            works on the one copy on the server, whichever device you start it from.
            This means you don't need to push from one machine and pull on another
            to carry on where an agent left off
          </li>
          <li>
            <strong class="font-semibold">Agents as employees.</strong> A session
            on the server stays open, so an agent can remain available and even wake
            itself up on a loop to keep work moving without you. I run
            <a
              href="/posts/what-my-ai-agents-decide-without-me"
              class="interactive link-underline">a whole team of them</a
            > this way
          </li>
          <li>
            <strong class="font-semibold">Scheduled jobs.</strong> They run on the
            server with your full setup, whether your laptop is on or not
          </li>
        </MarkedList>
        <p>
          New agent builds and scheduled jobs aren't part of the setup. Having
          the server is what lets you build them.
        </p>
      </Section>

      <Section id="included" title="What's included">
        <MarkedList>
          <li>
            A server in your own account, running Claude Code all the time on
            your own Claude subscription
          </li>
          <li>
            Your GitHub repos on it with their dependencies installed, and your
            skills, agents and settings copied from your laptop
          </li>
          <li>Your connectors working there too</li>
          <li>
            Nothing on the server is reachable from the public internet, the
            agents can't give themselves admin rights and security updates
            install themselves
          </li>
          <li>
            A 45-minute handover call where I move your setup across and we test
            it together
          </li>
          <li>14 days of fixes after the call</li>
        </MarkedList>
      </Section>

      <Section id="how" title="How it works">
        <MarkedList ordered>
          <li>
            <strong class="font-semibold">You order the server.</strong> It takes
            about 10 minutes with the steps I send you. It goes in your own account
            with the host, and you pay them about €31 a month
          </li>
          <li>
            <strong class="font-semibold">I build it.</strong> The build runs from
            public scripts, so you can read what gets installed on your server
          </li>
          <li>
            <strong class="font-semibold">We do one 45-minute call.</strong> You sign
            in to your own accounts (Claude, GitHub, your connectors) and I move your
            setup across. By the end your sessions run on the server, and we prove
            it by carrying one on from your phone with the laptop shut
          </li>
          <li>
            <strong class="font-semibold">I remove my access.</strong> The server
            and every account it uses are yours, and nothing about it depends on me
          </li>
        </MarkedList>
      </Section>

      <Section id="price" title="Price">
        <p>
          The price is one-off, plus VAT. The first three places are at a
          founding price, because you'd be among the first people I've set this
          up for and I'll ask for your feedback on how it went.
        </p>
        <table class="w-full border-collapse tabular-nums">
          <thead>
            <tr>
              {
                ["Place", "Price", "Status"].map(column => (
                  <th
                    scope="col"
                    class="border-b border-border py-3 pr-2 text-left label-caps text-foreground/75 last:pr-0 last:text-right"
                  >
                    {column}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              places.map(({ place, price, status }) => (
                <tr class:list={{ "text-foreground/75": !status }}>
                  <td class="border-b border-border py-3 pr-2">{place}</td>
                  <td
                    class:list={[
                      "border-b border-border py-3 pr-2 font-mono",
                      status
                        ? "text-[1.375rem] font-semibold tracking-[-0.02em]"
                        : "text-lg font-medium",
                    ]}
                  >
                    {price}
                  </td>
                  <td class="border-b border-border py-3 text-right">
                    {status && <StatusChip {status} />}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
          <Detail label="Timing">
            <p>I'll offer you a call within a week of payment.</p>
          </Detail>
          <Detail label="Holding a place">
            <p>
              A yes holds your place for 48 hours from when I send the invoice.
              Work starts once it's paid.
            </p>
          </Detail>
          <Detail label="Guarantee">
            <p>
              If Claude Code isn't running on your server with your repos,
              skills and connectors once we're done, I refund you in full. We
              check it by carrying on a session from your phone with your laptop
              shut.
            </p>
          </Detail>
          <Detail label="Running costs">
            <p>
              You pay for the server (about €31 a month on a one-month contract)
              and for your Claude plan, both direct.
            </p>
          </Detail>
        </div>
      </Section>

      <Section id="need" title="What you need">
        <MarkedList>
          <li>A paid Claude plan</li>
          <li>Your work in GitHub</li>
          <li>The Claude app on your phone</li>
          <li>A Mac or Linux laptop</li>
        </MarkedList>
        <p>
          If you're on a Team or Enterprise plan, you or your admin will need to
          switch on Remote Control in Claude's admin settings.
        </p>
        <p class="text-small text-foreground/75">
          The fixed price covers up to 10 repos and 5 connectors that use their
          own API keys. It doesn't cover maintenance after the 14 days, or
          designing and building agents, skills or loops. That's separate work,
          so ask me if you want it.
        </p>
      </Section>

      <Section id="questions" title="Questions">
        <Questions items={questions} />
      </Section>

      <Section id="cta" title="Get it set up" framed>
        <p>
          Tell me what you'd want running on it and I'll email you back to see
          if it fits.
        </p>
        <!-- Posts natively to Web3Forms when JavaScript is off, and inline
        through the script below otherwise – see docs/external-services.md -->
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="mt-3 flex flex-col gap-4"
          data-setup-form
          data-linkedin={linkedIn}
        >
          <input
            type="hidden"
            name="access_key"
            value={PUBLIC_WEB3FORMS_ACCESS_KEY}
          />
          <input
            type="hidden"
            name="subject"
            value="Cloud box setup enquiry via danhopwood.com"
          />
          <input type="hidden" name="from_name" value="danhopwood.com" />
          <input
            type="checkbox"
            name="botcheck"
            class="absolute -left-[9999px]"
            aria-hidden="true"
            tabindex="-1"
            autocomplete="off"
          />
          <Field
            id="setup-name"
            name="name"
            label="Name"
            autocomplete="name"
            required
          />
          <Field
            id="setup-email"
            name="email"
            label="Email"
            type="email"
            autocomplete="email"
            required
          />
          <Field
            id="setup-message"
            name="message"
            label="What you'd want running on it"
            rows={4}
            placeholder="e.g. 4 repos, Linear and Slack connectors, agents that review PRs while I'm away"
            required
          />
          <div class="flex flex-col items-start gap-2">
            <Button type="submit">Request setup</Button>
            <p class="text-sm" role="status" data-setup-status></p>
          </div>
        </form>
      </Section>

      <p class="border-t border-border pt-6 text-small text-foreground/75">
        How the setup works and why I run mine this way:
        <a
          href="/posts/running-ai-agents-on-a-30-euro-linux-box"
          class="interactive text-foreground link-underline"
          >Running AI agents on a €30 Linux box</a
        >.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const SUCCESS_LINE =
    "Thanks, that's with me. I'll reply by email, and nothing's booked until I send the invoice.";

  function showFailure(status: Element, linkedIn: string) {
    // A new tab, so the text the visitor typed survives
    const link = document.createElement("a");
    link.href = linkedIn;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.className = "interactive link-underline";
    link.textContent = "LinkedIn";
    status.replaceChildren(
      "That didn't send. Try again, or message me on ",
      link,
      "."
    );
  }

  // Never send a `redirect` field from here – see docs/external-services.md.
  async function send(form: HTMLFormElement) {
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
        // Safari before 16 has no AbortSignal.timeout. There the request runs
        // without a timeout, rather than throwing and failing every submit
        signal: AbortSignal.timeout?.(10000),
      });
      if (!response.ok) return false;
      const result = await response.json();
      return result.success === true;
    } catch {
      return false;
    }
  }

  function initSetupForm() {
    const form = document.querySelector<HTMLFormElement>(
      "form[data-setup-form]"
    );
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = "true";

    const button = form.querySelector<HTMLButtonElement>(
      "button[type=submit]"
    )!;
    const status = form.querySelector("[data-setup-status]")!;

    form.addEventListener("submit", async event => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = "";

      const ok = await send(form);

      button.disabled = false;
      if (ok) {
        form.reset();
        status.textContent = SUCCESS_LINE;
      } else {
        showFailure(status, form.dataset.linkedin!);
      }
      // Focus goes to the button on every route, Enter in a field included –
      // see "Disabling a focused button drops focus" in
      // docs/patterns/client-scripts.md
      button.focus();
    });
  }

  // See "Client scripts and View Transitions" in docs/patterns/client-scripts.md
  document.addEventListener("astro:page-load", initSetupForm);
  initSetupForm();
</script>
